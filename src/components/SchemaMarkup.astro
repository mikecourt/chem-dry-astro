---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  type?: 'homepage' | 'service' | 'city';
  serviceName?: string;
  city?: string;
  state?: string;
  postalCodes?: string[];
  faqs?: FAQ[];
}

const { type = 'homepage', serviceName, city, state = 'Colorado', postalCodes = [], faqs = [] } = Astro.props;

// Business coordinates (Highlands Ranch office)
const businessGeo = {
  "@type": "GeoCoordinates",
  "latitude": 39.5483,
  "longitude": -104.9697
};

// Physical address
const businessAddress = {
  "@type": "PostalAddress",
  "streetAddress": "8955 S. Ridgeline Blvd Unit 1800",
  "addressLocality": "Highlands Ranch",
  "addressRegion": "CO",
  "postalCode": "80129",
  "addressCountry": "US"
};

// Opening hours (Mon-Sat 7am-6pm)
const openingHours = [
  "Mo-Sa 07:00-18:00"
];

// Build areaServed based on city prop
const buildAreaServed = () => {
  if (city) {
    return {
      "@type": "City",
      "name": city,
      "containedInPlace": {
        "@type": "State",
        "name": state
      }
    };
  }
  // Default: Denver metro service area cities for homepage
  return [
    {"@type": "City", "name": "Denver"},
    {"@type": "City", "name": "Highlands Ranch"},
    {"@type": "City", "name": "Centennial"},
    {"@type": "City", "name": "Englewood"},
    {"@type": "City", "name": "Greenwood Village"},
    {"@type": "City", "name": "Littleton"},
    {"@type": "City", "name": "Lakewood"},
    {"@type": "City", "name": "Parker"},
    {"@type": "City", "name": "Thornton"}
  ];
};

// Base business schema with all local SEO properties
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Pro Chem-Dry",
  "description": "Professional carpet cleaning service in the Denver metro and Highlands Ranch area using Hot Carbonating Extraction technology. Independently owned and operated.",
  "url": "https://allprochemdry.com",
  "telephone": "+1-303-252-0517",
  "priceRange": "$$",
  "image": "https://allprochemdry.com/images/og-image.png",
  "address": businessAddress,
  "geo": businessGeo,
  "areaServed": buildAreaServed(),
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "07:00",
    "closes": "18:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "112",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://www.facebook.com/allprochemdry"
  ]
};

// Service-specific schema (for service pages and city pages)
const serviceSchema = (serviceName || city) ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": serviceName || `Carpet Cleaning in ${city}, ${state}`,
  "description": city
    ? `Professional carpet cleaning service in ${city}, ${state}. Hot Carbonating Extraction uses about 80% less water, dries in 1-2 hours.`
    : `Professional ${serviceName?.toLowerCase()} service in the Denver metro area.`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Pro Chem-Dry",
    "telephone": "+1-303-252-0517",
    "address": businessAddress,
    "geo": businessGeo,
    "priceRange": "$$"
  },
  "areaServed": buildAreaServed(),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "247",
    "bestRating": "5",
    "worstRating": "1"
  }
} : null;

// Strip HTML tags from FAQ answers for schema (schema.org recommends plain text)
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '');

// FAQPage schema (for city pages with FAQ sections)
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": stripHtml(faq.answer)
    }
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
{serviceSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
