---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  type?: 'homepage' | 'service' | 'city';
  serviceName?: string;
  city?: string;
  state?: string;
  postalCodes?: string[];
  faqs?: FAQ[];
}

const { type = 'homepage', serviceName, city, state = 'Illinois', postalCodes = [], faqs = [] } = Astro.props;

// Business coordinates (New Lenox office)
const businessGeo = {
  "@type": "GeoCoordinates",
  "latitude": 41.5220,
  "longitude": -87.9987
};

// Physical address
const businessAddress = {
  "@type": "PostalAddress",
  "streetAddress": "1042 Star Lane",
  "addressLocality": "New Lenox",
  "addressRegion": "IL",
  "postalCode": "60451",
  "addressCountry": "US"
};

// Opening hours (Mon-Sat 7am-6pm)
const openingHours = [
  "Mo-Sa 07:00-18:00"
];

// Build areaServed based on city prop
const buildAreaServed = () => {
  if (city) {
    return {
      "@type": "City",
      "name": city,
      "containedInPlace": {
        "@type": "State",
        "name": state
      }
    };
  }
  // Default: Chicagoland area for homepage
  return {
    "@type": "State",
    "name": "Illinois",
    "containedInPlace": {
      "@type": "Country",
      "name": "United States"
    }
  };
};

// Base business schema with all local SEO properties
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "K&T Chem-Dry",
  "description": "Professional carpet cleaning service in New Lenox and Chicagoland area using Hot Carbonating Extraction technology. Independently owned and operated.",
  "url": "https://ktchemdrycarpetcleaning.com",
  "telephone": "+1-815-469-3170",
  
  "priceRange": "$$",
  "image": "https://ktchemdrycarpetcleaning.com/images/og-image.png",
  "address": businessAddress,
  "geo": businessGeo,
  "areaServed": buildAreaServed(),
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "07:00",
    "closes": "18:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "89",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://www.facebook.com/ktchemdrynewlenox/"
  ]
};

// Service-specific schema (for service pages and city pages)
const serviceSchema = (serviceName || city) ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": serviceName || `Carpet Cleaning in ${city}, ${state}`,
  "description": city
    ? `Professional carpet cleaning service in ${city}, ${state}. Hot Carbonating Extraction uses about 80% less water, dries in 1-2 hours.`
    : `Professional ${serviceName?.toLowerCase()} service in the Phoenix metro area.`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "K&T Chem-Dry",
    "telephone": "+1-815-469-3170",
    "address": businessAddress,
    "geo": businessGeo,
    "priceRange": "$$"
  },
  "areaServed": buildAreaServed(),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "89",
    "bestRating": "5",
    "worstRating": "1"
  }
} : null;

// Strip HTML tags from FAQ answers for schema (schema.org recommends plain text)
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '');

// FAQPage schema (for city pages with FAQ sections)
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": stripHtml(faq.answer)
    }
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
{serviceSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
