---
/**
 * TestimonialCard.astro
 * Reusable testimonial card component matching city page styling.
 * Uses inline SVG for stars to avoid React hydration overhead.
 */

type Props = {
  name: string;
  location: string;
  content: string;
  source?: string;
  rating?: number;
  index?: number;
};

const {
  name,
  location,
  content,
  source,
  rating = 5,
  index = 0
} = Astro.props;

// Calculate animation delay based on index (100, 150, 200, etc.)
const animationDelay = 100 + (index * 50);
---

<div
  class="bg-white p-6 rounded-lg shadow-lg"
  data-aos="fade-up-sm"
  data-aos-delay={animationDelay.toString()}
>
  {/* Star Rating */}
  <div class="flex gap-1 mb-4">
    {[...Array(rating)].map(() => (
      <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  {/* Review Content */}
  <p class="text-base leading-relaxed text-text/80 mb-4 italic">
    "{content}"
  </p>

  {/* Reviewer Info */}
  <p class="text-sm font-semibold text-dark">{name}, {location}</p>

  {/* Source Attribution */}
  {source && (
    <p class="text-xs text-text/60">{source} Review</p>
  )}
</div>
