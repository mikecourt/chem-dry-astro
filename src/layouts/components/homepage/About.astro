---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import CustomButton from "../CustomButton.astro";
import CustomHeading from "../CustomHeading.astro";
import ImageMod from "../ImageMod.astro";

type Props = { about: CollectionEntry<"homepage">["data"]["about"] };

const { about } = Astro.props;
---

<section class="section pb-12 lg:pb-20 bg-light">
  <div class="container">
    <div
      class="flex flex-col lg:flex-row justify-between gap-32 lg:gap-10 items-center lg:items-start">
      <div class="lg:w-[55%]">
        <div class="relative">
          <ImageMod
            src="/images/map.jpg"
            alt="Denver metro service area map"
            width={549}
            height={465}
            class="rounded top-0 xl:-top-12 w-[80%]"
            data_aos="zoom-in-sm"
          />
          <ImageMod
            src="/images/phoenix-aerial.jpg"
            alt="Denver aerial view"
            width={470}
            height={317}
            class="absolute rounded right-0 -bottom-20 w-[60%]"
            data_aos="zoom-in-sm"
            data_aos_delay="20"
          />
          <div data-aos="zoom-in-sm" data-aos-delay="40">
            <ImageMod
              src="/images/valley-badge.svg"
              alt="Denver metro"
              width={223}
              height={223}
              class="hidden md:block absolute right-0 top-1/2 translate-y-[-140%] translate-x-[40%] spin-animation scale-80 w-[30%]"
            />
          </div>
        </div>
      </div>
      <div class="lg:w-[33%]">
        <p
          class="text-sm font-semibold tracking-wider uppercase text-accent mb-3 text-center lg:text-left"
          data-aos="fade-up-sm"
        >
          SERVICE AREA
        </p>

        <CustomHeading
          as="h2"
          text="Professional Carpet Cleaning Across **Denver Metro**"
          class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />
        <p
          class="text-lg md:text-xl text-text/80 mb-6 text-center lg:text-left"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          We proudly serve homes throughout the Denver metro, including:
        </p>

        <div
          class="grid grid-cols-2 gap-3 mb-6 max-w-xs mx-auto text-center"
          data-aos="fade-up-sm"
          data-aos-delay="150"
        >
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Highlands Ranch</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Denver</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Littleton</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Aurora</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Centennial</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Castle Rock</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Lakewood</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <span class="text-primary text-xl">✓</span>
            <span class="text-lg font-medium">Englewood</span>
          </div>
        </div>

        <div class="text-center mb-2 flex items-center justify-center gap-3">
          <span
            class="text-lg font-medium text-dark"
            data-aos="fade-up-sm"
            data-aos-delay="175"
          >
            And more!
          </span>
          <a
            href="/service-areas"
            class="text-lg font-medium text-primary hover:text-primary-dark inline-flex items-center gap-2"
            data-aos="fade-up-sm"
            data-aos-delay="200"
          >
            See all areas →
          </a>
        </div>

        <p
          class="text-base text-text/80 mb-4 text-center"
          data-aos="fade-up-sm"
          data-aos-delay="220"
        >
          ...or give us a call
        </p>

        <div
          class="w-full flex justify-center"
          data-aos="fade-up-sm"
          data-aos-delay="240"
        >
          <CustomButton
            link="tel:3032520517"
            label="(303) 252-0517"
            className="btn-sm! sm:btn!"
            variant="secondary"
            icon="FaPhone"
          />
        </div>
      </div>
    </div>
  </div>
</section>
