---
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";
import BlogCard from "../BlogCard.astro";
import CustomHeading from "../CustomHeading.astro";
import BeforeAfterCarousel from "./BeforeAfterCarousel.astro";

type Props = {
  blog: any;
  allBlogs: any[];
};

const { blog, allBlogs } = Astro.props;
---

<section class="section bg-light">
  <div class="container">
    <CustomHeading
      as="h2"
      text="Our **Results** Speak for Themselves"
      svgColor="text-accent"
      class="text-4xl md:text-5xl font-bold text-dark mb-4 text-center"
      dataAos="fade-up-sm"
    />
    <p
      class="text-lg md:text-xl text-text/80 mb-8 md:mb-12 text-center"
      data-aos="fade-up-sm"
      data-aos-delay="50"
    >
      When your home is clean, life is serene.
    </p>

    <BeforeAfterCarousel />
  </div>
</section>
