---
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import BlogCard from "../BlogCard.astro";
import CustomHeading from "../CustomHeading.astro";
import BeforeAfterCarousel from "./BeforeAfterCarousel.astro";

type Props = {
  blog: CollectionEntry<"homepage">["data"]["blog"];
  allBlogs: CollectionEntry<"blog">[];
};

const { blog, allBlogs } = Astro.props;
---

<section class="section bg-light">
  <div class="container">
    <p
      class="text-sm font-semibold tracking-wider uppercase text-accent mb-3 text-center"
      data-aos="fade-up-sm"
    >
      Before & After
    </p>
    <CustomHeading
      as="h2"
      text="When Your Home Is Clean, Life Is **Serene**"
      svgColor="text-accent"
      class="text-4xl md:text-5xl font-bold text-dark mb-8 md:mb-12 text-center"
      dataAos="fade-up-sm"
      dataAosDelay="50"
    />

    <BeforeAfterCarousel />
  </div>
</section>
