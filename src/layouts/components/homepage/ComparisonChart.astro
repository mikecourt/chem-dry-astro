---
import CustomHeading from "@/components/CustomHeading.astro";
import AllergenDisclaimer from "@/components/AllergenDisclaimer.astro";
---

<section class="section bg-light">
  <div class="container">
    <div class="mx-auto max-w-[75rem] text-center">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-accent mb-3"
        data-aos="fade-up-sm"
      >
        The Healthier, Deeper Carpet Cleaner
      </p>

      <!-- Section Heading -->
      <CustomHeading
        as="h2"
        text="The **Problem** with Steam Cleaning<br class='hidden md:block' /> (And Why We're Different)"
        svgColor="text-primary"
        class="text-3xl md:text-4xl lg:text-5xl font-bold mb-12 md:mb-16"
        style="color: #1A365D;"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- Comparison Grid -->
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-0 max-w-[700px] mx-auto"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        <!-- LEFT COLUMN - Steam Cleaning -->
        <div
          class="bg-white rounded-xl shadow-md border-2 border-amber-400 overflow-hidden relative z-10"
          data-aos="fade-right"
          data-aos-delay="150"
        >
          <!-- Header -->
          <div
            class="py-4 px-6"
            style="background-color: #FEF3C7; border-bottom: 2px solid #F59E0B;"
          >
            <h3
              class="text-xl md:text-2xl font-bold"
              style="color: #92400E;"
            >
              Steam Cleaning
            </h3>
          </div>

          <!-- Points -->
          <div class="py-8 px-6 space-y-4">
            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">❌</span>
              <div>
                <p class="text-base md:text-lg font-medium" style="color: #6B7280;">
                  Soaks Carpets Thoroughly
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #6B7280;">
                  Uses excessive amounts of water
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">❌</span>
              <div>
                <p class="text-base md:text-lg font-medium" style="color: #6B7280;">
                  1-2 Day Drying Time
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #6B7280;">
                  Disrupts your routine, carpet unusable
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">❌</span>
              <div>
                <p class="text-base md:text-lg font-medium" style="color: #6B7280;">
                  Leaves Sticky Residue
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #6B7280;">
                  Attracts dirt back faster, requiring more frequent cleaning
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">❌</span>
              <div>
                <p class="text-base md:text-lg font-medium" style="color: #6B7280;">
                  Extended Drying Time
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #6B7280;">
                  Carpet unusable for 1-2 days
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">❌</span>
              <div>
                <p class="text-base md:text-lg font-medium" style="color: #6B7280;">
                  Harsh Chemicals
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #6B7280;">
                  May irritate skin and airways
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN - Brimley's Chem-Dry -->
        <div
          class="bg-white rounded-xl shadow-lg border-4 overflow-hidden lg:transform lg:scale-105 relative z-20 lg:-ml-[5%]"
          style="border-color: #41AD49;"
          data-aos="fade-left"
          data-aos-delay="200"
        >
          <!-- Header -->
          <div
            class="py-4 px-6"
            style="background-color: #D1FAE5; border-bottom: 3px solid #41AD49;"
          >
            <h3
              class="text-xl md:text-2xl font-bold"
              style="color: #1A365D;"
            >
              Brimley's Chem-Dry
            </h3>
            <p
              class="text-xs md:text-sm font-medium mt-1"
              style="color: #1A365D;"
            >
              Hot Carbonating Extraction
            </p>
          </div>

          <!-- Points -->
          <div class="py-8 px-6 space-y-4">
            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">✅</span>
              <div>
                <p class="text-base md:text-lg font-semibold" style="color: #1A365D;">
                  Uses About 80% Less Water
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #4B5563;">
                  Gentle carbonating bubbles lift dirt
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">✅</span>
              <div>
                <p class="text-base md:text-lg font-semibold" style="color: #1A365D;">
                  Dries in 2 Hours
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #4B5563;">
                  Back to normal fast—perfect for busy families
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">✅</span>
              <div>
                <p class="text-base md:text-lg font-semibold" style="color: #1A365D;">
                  No Dirt-Attracting Residue
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #4B5563;">
                  Stays cleaner longer between cleanings
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">✅</span>
              <div>
                <p class="text-base md:text-lg font-semibold" style="color: #1A365D;">
                  Removes 98% of Common Household Allergens*
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #4B5563;">
                  Healthier home for kids and pets
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-left">
              <span class="text-2xl flex-shrink-0">✅</span>
              <div>
                <p class="text-base md:text-lg font-semibold" style="color: #1A365D;">
                  No Harsh Chemicals
                </p>
                <p class="text-xs md:text-sm mt-1" style="color: #4B5563;">
                  The Natural® uses carbonation, not harsh chemicals
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <AllergenDisclaimer />
    </div>
  </div>
</section>
