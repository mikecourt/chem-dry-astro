---
import CustomHeading from "@/components/CustomHeading.astro";
---

<!-- 100% Satisfaction Guarantee Section -->
<section class="bg-light">
  <div class="container">
    <div class="mx-auto max-w-[50rem]">
      <!-- Certificate Container -->
      <div class="bg-white rounded-2xl border-2 border-primary/20 shadow-2xl p-8 md:p-12 lg:p-16 text-center" data-aos="zoom-in-sm">
        <!-- Icon/Badge -->
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary/10 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>

        <!-- H2 with SVG swoosh - DESIGN SYSTEM STANDARD -->
        <CustomHeading
          as="h2"
          text="100% **Satisfaction** Guaranteed"
          svgColor="text-primary"
          class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />

        <!-- Content -->
        <div class="space-y-4" data-aos="fade-up-sm" data-aos-delay="100">
          <p class="text-lg leading-relaxed text-text/80">
            If you're not thrilled with your results, we'll make it right—at no extra charge.
          </p>

          <p class="text-base leading-relaxed text-text/80">
            We'll return and re-clean any area you're not happy with, free of charge. Still not satisfied? We'll refund your money. No hassle, no fine print.
          </p>

          <p class="text-base leading-relaxed text-text/80">
            After 30 years in business, our A+ Better Business Bureau rating and thousands of 5-star reviews speak for themselves. We stand behind our work because our reputation depends on it.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
