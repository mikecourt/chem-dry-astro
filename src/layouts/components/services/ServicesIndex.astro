---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import CustomHeading from "../CustomHeading.astro";

type Props = {
  serviceIndex: CollectionEntry<"services">["data"];
  allServices: CollectionEntry<"services">[];
};

const { serviceIndex, allServices } = Astro.props;

// Service descriptions for the services index page
const serviceDescriptions: Record<string, string> = {
  "carpet-cleaning": "Tired of carpets that stay wet for days? Our Hot Carbonating Extraction process dries in just 1-2 hours and uses 80% less water than traditional steam cleaning. No dirt-attracting residue means your carpets stay cleaner longer.",
  "upholstery-cleaning": "Your furniture takes a beating from daily use, spills, and allergens. Our natural cleaning solution is tough on stains yet completely safe for kids and pets. We'll bring your upholstery back to life without harsh chemicals.",
  "tile-grout-cleaning": "Scrubbing grout on your hands and knees is exhausting and rarely works. We use professional-grade equipment to restore your tile's original color and seal it to prevent future staining and mildew.",
  "area-rug-cleaning": "Expensive rugs deserve expert care. Our specialists understand different fibers, dyes, and construction methods to clean your investment safely. We preserve colors and prevent damage that generic cleaning can cause.",
  "pet-urine-removal": "Most cleaners just mask the smell temporarily. Our P.U.R.T.® treatment actually breaks down urine crystals at the molecular level, eliminating odors permanently. Say goodbye to embarrassing pet odors for good.",
  "commercial-cleaning": "Your business makes a first impression the moment clients walk in. We minimize disruption with fast-drying methods and flexible scheduling. Keep your workspace looking professional without losing productivity.",
  "specialty-stain-removal": "Some stains seem impossible to remove. Our trained technicians know which treatments work for specific stains—from wine and coffee to ink and dye. We've seen it all and removed most of it.",
  "wood-floor-cleaning": "Wood floors lose their luster from dirt buildup and foot traffic. Our gentle process removes grime without excess moisture that can damage wood. We'll restore the natural beauty of your hardwood.",
  "leather-cleaning": "Leather furniture is a significant investment that needs special care. Our conditioning treatment cleans deeply while maintaining the leather's suppleness. Don't let your leather dry out, crack, or fade prematurely.",
  "granite-countertop-renewal": "Granite countertops can lose their shine and develop stains over time. We remove buildup, restore the original polish, and seal the surface to protect your investment and keep it looking stunning.",
  "stone-tile-cleaning-polishing": "Natural stone needs different care than ceramic tile. We understand the unique needs of marble, travertine, and other stone surfaces. Our process cleans and polishes without causing etching or damage.",
  "pet-urine-stain-removal": "Pet stains don't just smell—they can permanently damage flooring if not treated properly. We locate hidden urine spots with UV light and treat them thoroughly. Save your floors from permanent damage.",
  "couch-sofa-cleaning": "Your couch is where life happens—movie nights, afternoon naps, family time. It deserves regular professional cleaning to remove body oils, allergens, and odors. Extend its life and keep it fresh.",
  "red-wine-stain-removal": "Red wine stains strike fear in homeowners' hearts. Acting fast is crucial, but even old wine stains can often be removed with professional treatment. Don't give up on that carpet or upholstery yet.",
  "allergen-removal": "Dust mites, pollen, and pet dander hide deep in carpets and upholstery. Our Hot Carbonating Extraction removes allergens that vacuuming can't reach. Breathe easier and reduce allergy symptoms at home.",
  "dryer-vent-cleaning": "Clogged dryer vents are a leading cause of house fires. We thoroughly clean your vent system to improve dryer efficiency, reduce energy costs, and most importantly—keep your family safe."
};

// Service images mapping
const serviceImages: Record<string, string> = {
  "carpet-cleaning": "/images/service/carpet-cleaning.jpg",
  "upholstery-cleaning": "/images/service/upholstery-cleaning.jpg",
  "tile-grout-cleaning": "/images/service/tile-cleaning.jpg",
  "area-rug-cleaning": "/images/service/area-rug-cleaning.jpg",
  "pet-urine-removal": "/images/service/pet-odor.jpg",
  "commercial-cleaning": "/images/service/commercial-cleaning.jpg",
  "specialty-stain-removal": "/images/service/specialty-stain.jpg",
  "wood-floor-cleaning": "/images/service/wood-floor-cleaning.jpg",
  "leather-cleaning": "/images/service/leather-cleaning.jpg",
  "granite-countertop-renewal": "/images/service/granite-renewal.jpg",
  "stone-tile-cleaning-polishing": "/images/service/stone-cleaning.jpg",
  "pet-urine-stain-removal": "/images/service/pet-urine.jpg",
  "couch-sofa-cleaning": "/images/service/sofa-cleaning.jpg",
  "red-wine-stain-removal": "/images/service/wine-stain.jpg",
  "allergen-removal": "/images/service/allergen-removal.jpg",
  "dryer-vent-cleaning": "/images/service/dryer-vent-cleaning.jpg"
};
---

<!-- Hero Section with Headline and Body Copy -->
<section class="section mt-24 sm:mt-20 !pb-8 md:!pb-12">
  <div class="container">
    <div class="mx-auto max-w-[65rem] text-center">
      {/* Eyebrow - DESIGN SYSTEM STANDARD */}
      {
        serviceIndex?.subtitle && (
          <p
            set:html={markdownify(serviceIndex?.subtitle)}
            class="text-sm font-semibold tracking-wider uppercase text-primary mb-3"
            data-aos="fade-up-sm"
          />
        )
      }

      {/* H1 - DESIGN SYSTEM STANDARD with swoosh under "Professional" */}
      <CustomHeading
        as="h1"
        text="**Professional** Carpet & Upholstery Cleaning Services – Phoenix Metro"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
        dataAos="fade-up-sm"
      />

      {/* H2 - contained to body column width */}
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 md:mb-12"
        data-aos="fade-up-sm"
        data-aos-delay="50"
      >
        Dries in 2 Hours. Uses About 80% Less Water. Safe for Kids & Pets.
      </h2>

      {/* Body Copy in Two Columns */}
      <div
        class="grid md:grid-cols-2 gap-6 lg:gap-8 text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        <div>
          <p class="text-base leading-relaxed text-text/80">
            At Brimley's White Glove Chem-Dry, we've perfected the art of getting your home truly clean—without the wait, harsh chemicals, or sticky residue. Our Hot Carbonating Extraction process uses about 80% less water than traditional steam cleaning, so your carpets dry in just 1-2 hours.
          </p>
        </div>
        <div>
          <p class="text-base leading-relaxed text-text/80">
            The Natural® cleaning solution we use is powerful enough to remove deep-down dirt and allergens, yet gentle enough to be completely safe for kids and pets. Serving Phoenix Valley families since 1995, we offer a full range of cleaning services backed by our 100% satisfaction guarantee.
          </p>
        </div>
      </div>
    </div>

    {/* Trust Badges - Light Green Pills */}
    <div
      class="flex flex-wrap gap-3 mt-10 md:mt-12 justify-center max-w-[120rem] mx-auto"
      data-aos="fade-up-sm"
      data-aos-delay="150"
    >
        {/* Certified & Insured */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">Certified & Insured Technicians</p>
        </div>

        {/* Same-Day Service */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">Same-Day Service Available</p>
        </div>

        {/* Free Estimates */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">Free Estimates</p>
        </div>

        {/* Satisfaction Guarantee */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">100% Satisfaction Guarantee</p>
        </div>

        {/* Hot Carbonating Extraction */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">Hot Carbonating Extraction deep-clean</p>
        </div>

        {/* Less Water */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">About 80% less water than steam cleaning</p>
        </div>

        {/* No Residue */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">No dirt-attracting residue</p>
        </div>

        {/* Non-toxic */}
        <div class="flex items-center justify-start gap-2.5 px-4 py-2.5 bg-primary/20 rounded-full">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-xs font-medium text-dark leading-tight text-left">Non-toxic cleaning solutions</p>
        </div>
    </div>
  </div>
</section>

<!-- Service Cards Section with Light Gray Background -->
<section class="section pt-0 bg-gray-100">
  <div class="container">
    {/* Filter Menu */}
    <div class="pt-4 mb-6">
      <div class="flex flex-wrap gap-2" id="filter-menu">
        <button
          data-category="all"
          class="filter-btn active px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-primary text-white"
        >
          All Services
        </button>
        <button
          data-category="Carpets & Rugs"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Carpets & Rugs
        </button>
        <button
          data-category="Furniture & Upholstery"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Furniture & Upholstery
        </button>
        <button
          data-category="Hard Floors & Surfaces"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Hard Floors & Surfaces
        </button>
        <button
          data-category="Stains & Spills"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Stains & Spills
        </button>
        <button
          data-category="Pet Issues"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Pet Issues
        </button>
        <button
          data-category="Health & Allergies"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Health & Allergies
        </button>
        <button
          data-category="Business & Commercial"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-white text-dark hover:bg-primary/10"
        >
          Business & Commercial
        </button>
      </div>
    </div>

    <div
      class="grid gap-8 grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
      id="services-grid">
      {
        allServices.map((service, i) => (
          <div
            class="group h-full service-card"
            data-categories={JSON.stringify(service.data.categories || [])}
            data-aos="fade-up-sm"
            data-aos-delay={100 + i * 50}>
            <a
              href={`/services/${service.id}`}
              class="block h-full bg-white rounded-lg overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300">

              {/* Photo with hover magnification */}
              <div class="relative h-64 overflow-hidden">
                <img
                  src={serviceImages[service.id] || "/images/service/2.png"}
                  alt={service.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </div>

              {/* Card Content */}
              <div class="p-6">
                {/* Service Name as Heading/Link */}
                <h3
                  set:html={markdownify(service.data.title!)}
                  class="text-2xl font-bold text-dark mb-3 group-hover:text-accent transition-colors"
                />

                {/* Description */}
                <p class="text-base text-text/80 leading-relaxed mb-4">
                  {serviceDescriptions[service.id] || ""}
                </p>

                {/* Learn More Link */}
                <div class="relative overflow-hidden w-fit">
                  <span class="font-medium text-nowrap inline-flex items-center group text-base text-accent group-hover:text-accent/80 transition-colors">
                    <span class="-translate-x-[86%] transform transition-transform duration-300 inline-flex items-center group-hover:translate-x-0">
                      Learn More
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-4 h-4 ml-1">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </span>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const serviceCards = document.querySelectorAll('.service-card');
    let activeFilters = new Set(['all']);

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.dataset.category;

        if (category === 'all') {
          // Reset all filters
          activeFilters.clear();
          activeFilters.add('all');

          // Update button states
          filterButtons.forEach(btn => {
            if (btn.dataset.category === 'all') {
              btn.classList.add('active', 'bg-primary', 'text-white');
              btn.classList.remove('bg-white', 'text-dark');
            } else {
              btn.classList.remove('active', 'bg-primary', 'text-white');
              btn.classList.add('bg-white', 'text-dark');
            }
          });
        } else {
          // Remove 'all' if selecting specific category
          activeFilters.delete('all');
          document.querySelector('[data-category="all"]')?.classList.remove('active', 'bg-primary', 'text-white');
          document.querySelector('[data-category="all"]')?.classList.add('bg-white', 'text-dark');

          // Toggle the clicked category
          if (activeFilters.has(category)) {
            activeFilters.delete(category);
            button.classList.remove('active', 'bg-primary', 'text-white');
            button.classList.add('bg-white', 'text-dark');
          } else {
            activeFilters.add(category);
            button.classList.add('active', 'bg-primary', 'text-white');
            button.classList.remove('bg-white', 'text-dark');
          }

          // If no filters selected, show all
          if (activeFilters.size === 0) {
            activeFilters.add('all');
            document.querySelector('[data-category="all"]')?.classList.add('active', 'bg-primary', 'text-white');
            document.querySelector('[data-category="all"]')?.classList.remove('bg-white', 'text-dark');
          }
        }

        // Filter service cards
        filterServices();
      });
    });

    function filterServices() {
      serviceCards.forEach(card => {
        const cardCategories = JSON.parse(card.dataset.categories || '[]');

        if (activeFilters.has('all')) {
          card.style.display = '';
        } else {
          // Show card if it has ANY of the active filters
          const hasMatch = cardCategories.some(cat => activeFilters.has(cat));
          card.style.display = hasMatch ? '' : 'none';
        }
      });
    }
  });
</script>
