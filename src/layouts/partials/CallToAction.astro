---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  cta: CollectionEntry<"ctaSection">["data"];
};

const { cta } = Astro.props;
---

{
  cta.enable && (
    <section
      class="section pt-16 md:pt-24 pb-0 bg-primary relative overflow-hidden"
      data-aos="fade-in-sm">
      <div class="container relative pb-16 md:pb-24">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          {/* Left Column - Content (40%) */}
          <div class="w-full lg:w-[40%]">
            {cta.subtitle && (
              <p
                set:html={markdownify(cta.subtitle)}
                class="mb-4 text-sm font-semibold tracking-wider uppercase text-white/90"
                data-aos="fade-up-sm"
              />
            )}
            {cta.title && (
              <h2
                class="text-4xl md:text-5xl font-bold text-white mb-4 md:mb-6"
                data-aos="fade-up-sm"
                data-aos-delay="50"
              >
                {cta.title}
              </h2>
            )}
            {cta.content && (
              <p
                set:html={markdownify(cta.content)}
                class="mb-8 text-white/90 text-base leading-relaxed"
                data-aos="fade-up-sm"
                data-aos-delay="100"
              />
            )}

            <div class="flex flex-col sm:flex-row gap-4">
              {cta.buttons &&
                cta.buttons.map(
                  (b, i: number) =>
                    b.enable && (
                      <CustomButton
                        link={b.link}
                        label={b.label}
                        className="w-fit"
                        variant={i % 2 === 0 ? "secondary" : "outline-white"}
                        data_aos="fade-up-sm"
                        data_aos_delay={100 + i * 50}
                        icon={b?.icon && b?.icon}
                      />
                    )
                )}
            </div>
          </div>

          {/* Right Column - Form (60%) */}
          <div class="w-full lg:w-[60%]" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="bg-white rounded-lg p-6 md:p-8 shadow-xl">
              <form action="/api/contact" method="POST" class="space-y-5" id="cta-form">
                {/* Name Field */}
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                    Name
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="Your name"
                  />
                </div>

                {/* Email Field */}
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="your.email@example.com"
                  />
                </div>

                {/* Phone Field */}
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                    Phone <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="(480) 123-4567"
                  />
                </div>

                {/* Zip Code Field */}
                <div>
                  <label for="zipcode" class="block text-sm font-medium text-gray-700 mb-2">
                    Zip Code <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="zipcode"
                    name="zipcode"
                    required
                    pattern="[0-9]{5}"
                    maxlength="5"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="85001"
                  />
                </div>

                {/* How Can We Help Field */}
                <div>
                  <label for="services" class="block text-sm font-medium text-gray-700 mb-2">
                    How can we help?
                  </label>
                  <textarea
                    id="services"
                    name="services"
                    rows="3"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
                    placeholder="Tell us what services you're interested in..."
                  ></textarea>
                </div>

                {/* Submit Button */}
                <button
                  type="submit"
                  class="w-full py-4 px-6 font-semibold rounded-lg transition-all duration-200 hover:shadow-lg"
                  style="background-color: #F5D878; color: #2D2D2D;"
                  onmouseover="this.style.backgroundColor='#E5C158'"
                  onmouseout="this.style.backgroundColor='#F5D878'"
                >
                  Get Your Free Estimate Now
                </button>
              </form>
            </div>
          </div>
        </div>

        {/* Team Image - Pops up from bottom */}
        <div
          id="team-image"
          class="hidden lg:block absolute left-0 w-[60%] transition-transform duration-700 ease-out z-20"
          style="bottom: 0; transform: translateY(100%);"
        >
          <picture>
            <source srcset="/images/cta-team.webp" type="image/webp" />
            <img
              src="/images/cta-team.png"
              alt="Brimley's White Glove Chem-Dry Team"
              class="w-full h-auto object-contain block"
              style="display: block; margin: 0; padding: 0;"
              loading="lazy"
              width="1200"
              height="800"
            />
          </picture>
        </div>
      </div>

      <script>
        // Intersection Observer to trigger team image animation
        const observerCallback = (entries: IntersectionObserverEntry[]) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const teamImage = document.getElementById('team-image');
              if (teamImage) {
                teamImage.style.transform = 'translateY(0)';
              }
            }
          });
        };

        const observer = new IntersectionObserver(observerCallback, {
          threshold: 0.5,
          rootMargin: '0px'
        });

        // Observe the submit button
        const form = document.getElementById('cta-form');
        if (form) {
          const submitButton = form.querySelector('button[type="submit"]');
          if (submitButton) {
            observer.observe(submitButton);
          }
        }
      </script>
    </section>
  )
}
