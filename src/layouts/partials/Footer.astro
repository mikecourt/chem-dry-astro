---
import config from "@/config/config.json";
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { copyright } = config.params;
---

<footer class="section py-16 md:py-20 bg-text">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      {/* Column 1: Our Services */}
      <div data-aos="fade-up-sm">
        <h3 class="mb-6 font-semibold text-white text-lg">OUR SERVICES</h3>
        <ul class="space-y-3">
          <li><a href="/services/carpet-cleaning" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Carpet Cleaning</a></li>
          <li><a href="/services/upholstery-cleaning" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Upholstery Cleaning</a></li>
          <li><a href="/services/area-rug-cleaning" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Area Rug Cleaning</a></li>
          <li><a href="/services/tile-grout-cleaning" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Tile & Grout Cleaning</a></li>
          <li><a href="/services/pet-urine-removal" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Pet Odor Removal</a></li>
          <li><a href="/services/leather-cleaning" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Leather Cleaning</a></li>
          <li><a href="/services/granite-countertop-renewal" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Granite Renewal</a></li>
        </ul>
      </div>

      {/* Column 2: Service Areas */}
      <div data-aos="fade-up-sm" data-aos-delay="50">
        <h3 class="mb-6 font-semibold text-white text-lg">SERVICE AREAS</h3>
        <ul class="space-y-3">
          {/* East Valley */}
          <li><a href="/phoenix" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Phoenix</a></li>
          <li><a href="/mesa" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Mesa</a></li>
          <li><a href="/gilbert" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Gilbert</a></li>
          <li><a href="/chandler" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Chandler</a></li>
          <li><a href="/tempe" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Tempe</a></li>
          <li><a href="/scottsdale" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Scottsdale</a></li>
          <li><a href="/queen-creek" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Queen Creek</a></li>
          {/* West Valley */}
          <li><a href="/glendale" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Glendale</a></li>
          <li><a href="/peoria" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Peoria</a></li>
          <li><a href="/apache-junction" class="text-text-light/80 text-sm hover:text-primary transition-colors">• Apache Junction</a></li>
          <li><a href="/san-tan-valley" class="text-text-light/80 text-sm hover:text-primary transition-colors">• San Tan Valley</a></li>
        </ul>
      </div>

      {/* Column 3: Contact Us */}
      <div data-aos="fade-up-sm" data-aos-delay="100">
        <h3 class="mb-6 font-semibold text-white text-lg">CONTACT US</h3>
        <div class="space-y-4">
          <p class="text-white font-semibold text-base">Brimley's White Glove Chem-Dry</p>
          <p><a href="tel:4806493663" class="text-text-light/80 text-sm hover:text-primary transition-colors" data-track="phone-click" data-track-location="footer">(480) 649-3663</a></p>
          <p><a href="mailto:office@whiteglovecarpet.com" class="text-text-light/80 text-sm hover:text-primary transition-colors">office@whiteglovecarpet.com</a></p>
          <p class="text-text-light/80 text-sm">1451 N Delmar<br/>Mesa, AZ 85203</p>

          <div class="mt-6 pt-6 border-t border-text-light/20">
            <p class="text-white font-semibold text-sm mb-2">Business Hours:</p>
            <p class="text-text-light/80 text-sm">Mon-Fri: 8am - 5pm</p>
            <p class="text-text-light/80 text-sm">Sat: 9am - 1pm</p>
          </div>

          <div class="mt-6 pt-6 border-t border-text-light/20">
            <div class="flex gap-4">
              <a href="https://www.facebook.com/profile.php?id=61570743319721" target="_blank" rel="noopener noreferrer" class="text-text-light/80 hover:text-primary transition-colors" aria-label="Facebook">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </a>
              <a href="https://www.instagram.com/brimleyswhiteglovechemdry/" target="_blank" rel="noopener noreferrer" class="text-text-light/80 hover:text-primary transition-colors" aria-label="Instagram">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
                </svg>
              </a>
              <a href="https://www.youtube.com/@BrimleysWhiteGloveChemDry" target="_blank" rel="noopener noreferrer" class="text-text-light/80 hover:text-primary transition-colors" aria-label="YouTube">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Column 4: Get A Free Estimate Form */}
      <div data-aos="fade-up-sm" data-aos-delay="150">
        <h3 class="mb-6 font-semibold text-white text-lg">GET A FREE ESTIMATE</h3>
        <form action="/api/contact" method="POST" class="space-y-3" data-track="quote-form" data-track-location="footer">
          <input
            type="text"
            name="name"
            placeholder="Name"
            required
            class="w-full px-3 py-2 text-sm border border-text-light/30 rounded bg-transparent text-white placeholder:text-text-light/50 focus:border-primary focus:outline-none transition-colors"
          />
          <input
            type="tel"
            name="phone"
            placeholder="Phone"
            required
            class="w-full px-3 py-2 text-sm border border-text-light/30 rounded bg-transparent text-white placeholder:text-text-light/50 focus:border-primary focus:outline-none transition-colors"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="w-full px-3 py-2 text-sm border border-text-light/30 rounded bg-transparent text-white placeholder:text-text-light/50 focus:border-primary focus:outline-none transition-colors"
          />
          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-primary text-white text-sm font-semibold rounded hover:bg-primary/90 transition-colors"
            data-track="cta-click"
            data-track-action="submit-quote"
          >
            REQUEST ESTIMATE
          </button>
        </form>

        {/* Company Logo */}
        <div class="mt-8 pt-6 border-t border-text-light/20 flex justify-center">
          <Image
            src="/images/logo-white.svg"
            width={200}
            height={60}
            alt="Brimley's White Glove Chem-Dry"
            class="w-4/5 h-auto opacity-80"
          />
        </div>
      </div>
    </div>

    {/* Trust Bar */}
    <div class="mt-12 pt-8 border-t border-text-light/20">
      <div class="flex items-center justify-center gap-8 md:gap-12 lg:gap-16 mb-8" data-aos="fade-up-sm">
        <picture class="h-24 md:h-28 lg:h-32 w-auto opacity-80 hover:opacity-100 transition-opacity">
          <source srcset="/images/trust-badge-1.webp" type="image/webp" />
          <img
            src="/images/trust-badge-1.png"
            width="200"
            height="100"
            alt="Chem-Dry Certification"
            class="h-24 md:h-28 lg:h-32 w-auto"
            loading="lazy"
          />
        </picture>
        <picture class="h-24 md:h-28 lg:h-32 w-auto opacity-80 hover:opacity-100 transition-opacity">
          <source srcset="/images/trust-badge-2.webp" type="image/webp" />
          <img
            src="/images/trust-badge-2.png"
            width="200"
            height="100"
            alt="Best of State Award"
            class="h-24 md:h-28 lg:h-32 w-auto"
            loading="lazy"
          />
        </picture>

        {/* Elfsight Review Widgets */}
        <!-- Elfsight Google Reviews | Untitled Google Reviews -->
        <div class="elfsight-app-dac66efe-1ba0-40a4-907f-940c64b4f0ef" data-elfsight-app-lazy></div>

        <!-- Elfsight Yelp Reviews | Yelp Badge -->
        <div class="elfsight-app-7c3dc6e3-a8b7-4a11-a81e-8bac3a6fd937" data-elfsight-app-lazy></div>
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-12 pt-8 pb-8 border-t border-text-light/30">
      <p class="text-center text-base text-white/60">
        © 2025 Brimley's White Glove Chem-Dry. All Rights Reserved. | <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a> | <a href="/sitemap.xml" class="hover:text-white transition-colors">Sitemap</a> | Locally Owned & Operated Since 1995.
      </p>
    </div>
  </div>
</footer>
