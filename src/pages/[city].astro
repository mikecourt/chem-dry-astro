---
import Base from "@/layouts/Base.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import TrustBar from "@/components/TrustBar.astro";
import AllergenDisclaimer from "@/components/AllergenDisclaimer.astro";
import CallToAction from "@/partials/CallToAction.astro";
import CityTestimonials from "@/components/CityTestimonials.astro";
import { sanityClient } from "@/lib/sanity";
import { fetchCta } from "@/lib/fetchCta";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<Array<{ slug: { current: string } }>>(
    `*[_type == "cityPage"]{ slug }`
  );

  return slugs.map((doc) => ({
    params: { city: doc.slug.current },
  }));
}

const { city: citySlug } = Astro.params;

// Fetch all city slugs for the "Nearby Cities" section
const allCitySlugs = await sanityClient.fetch<Array<{ slug: string; city: string }>>(
  `*[_type == "cityPage" && slug.current != $slug]{ "slug": slug.current, city }`,
  { slug: citySlug }
);

// Fetch full city page data from Sanity
const data = await sanityClient.fetch<{
  city: string;
  slug: { current: string };
  state: string;
  metaTitle: string;
  metaDescription: string;
  canonical: string;
  heroTitle: string;
  heroSubtitle: string;
  whyChooseContent: string;
  neighborhoods: Array<{
    name: string;
    title: string;
    description: string;
    highlights: string[];
    icon: string;
  }>;
  services: Array<{
    title: string;
    description: string;
    icon: string;
    link: string;
  }>;
  zipCodes: Array<{
    zip: string;
    area: string;
  }>;
  faqs: Array<{
    question: string;
    answer: string;
  }>;
}>(
  `*[_type == "cityPage" && slug.current == $slug][0]`,
  { slug: citySlug }
);

const call_to_action = await fetchCta();

const neighborhoods = data?.neighborhoods ?? [];
const services = data?.services ?? [];
const zipCodes = data?.zipCodes ?? [];
const faqs = data?.faqs ?? [];
const cityName = data?.city ?? citySlug;
const stateName = data?.state ?? "Arizona";
const postalCodes = zipCodes.map((z) => z.zip);

// Render neighborhood icon as emoji
function neighborhoodEmoji(icon: string): string {
  const map: Record<string, string> = {
    FaHome: "🏠",
    FaStar: "⭐",
    FaCrown: "👑",
    FaMountain: "⛰️",
    FaLeaf: "🌿",
    FaTree: "🌲",
    FaWater: "💧",
    FaCity: "🏙️",
    FaSun: "☀️",
    FaMap: "🗺️",
  };
  return map[icon] ?? "📍";
}

// Render service icon as emoji
function serviceEmoji(icon: string): string {
  const map: Record<string, string> = {
    FaHouseUser: "🏠",
    FaTh: "🔲",
    FaCouch: "🛋️",
    FaPaw: "🐾",
    FaRug: "🧶",
    FaLeaf: "🌿",
    FaBroom: "🧹",
    FaShieldAlt: "🛡️",
    FaWater: "💧",
    FaStar: "⭐",
  };
  return map[icon] ?? "✨";
}
---

<Base
  meta_title={data?.metaTitle}
  description={data?.metaDescription}
  canonical={data?.canonical}
>
  <SchemaMarkup
    type="city"
    city={cityName}
    state={stateName}
    postalCodes={postalCodes}
    faqs={faqs}
  />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-32 lg:py-40 relative mb-0 bg-gradient-to-br from-primary/5 via-white to-accent/5"
  >
    <div class="container mx-auto px-4">
      <div class="text-center max-w-5xl mx-auto">
        <!-- Subtitle -->
        <p
          class="text-accent font-semibold text-lg md:text-xl mb-4 tracking-wide uppercase"
          data-aos="fade-up-sm"
        >
          {data?.heroSubtitle ?? `Carpet Cleaning ${cityName}, ${stateName}`}
        </p>

        <!-- Main Heading -->
        <CustomHeading
          as="h1"
          text={data?.heroTitle ?? `Professional Carpet Cleaning in ${cityName}, ${stateName}`}
          svgColor="text-primary"
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />

        <!-- Subheading -->
        <p
          class="text-xl md:text-2xl text-text/80 mb-8 font-medium"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Serving {cityName} Neighborhoods Since 1995
        </p>

        <!-- Trust Badges - Neighborhoods Focus -->
        {neighborhoods.length > 0 && (
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 max-w-4xl mx-auto"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            {neighborhoods.slice(0, 4).map((neighborhood) => (
              <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
                <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
                  {neighborhoodEmoji(neighborhood.icon)}
                </div>
                <div class="text-left">
                  <div class="font-bold text-dark text-sm md:text-base">{neighborhood.name}</div>
                  <div class="text-xs md:text-sm text-gray-600">{neighborhood.highlights?.[0] ?? "Trusted Service"}</div>
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row justify-center items-center gap-4"
          data-aos="fade-up-sm"
          data-aos-delay="200"
        >
          <CustomButton
            link="tel:4806493663"
            label="Call (480) 649-3663"
            variant="primary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="phone-click"
            data_track_location={`hero-${citySlug}`}
          />
          <CustomButton
            link="#contact-form"
            label="Schedule Online"
            variant="secondary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="cta-click"
            data_track_location={`hero-${citySlug}`}
            data_track_action="navigate-appointment"
          />
        </div>

        <!-- Additional Trust Points -->
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-text/70">
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Dries in 1-2 Hours</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>No Harsh Chemicals</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Family Owned Since 1995</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>All {cityName} Neighborhoods</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Neighborhoods Section - FEATURED -->
  {neighborhoods.length > 0 && (
    <section class="section bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <p
            class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
            data-aos="fade-up-sm"
          >
            Local Expertise
          </p>
          <CustomHeading
            as="h2"
            text={`${cityName} Neighborhoods We Serve`}
            svgColor="text-accent"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p
            class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            We're not just in {cityName}—we're of {cityName}. Our technicians know your neighborhood and understand what your home needs.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
          {neighborhoods.map((neighborhood, index) => (
            <div
              class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 lg:p-10 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
              data-aos="fade-up-sm"
              data-aos-delay={index * 100}
            >
              <div class="flex items-start gap-4 mb-6">
                <div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white text-3xl flex-shrink-0">
                  {neighborhoodEmoji(neighborhood.icon)}
                </div>
                <div>
                  <h3 class="text-2xl md:text-3xl font-bold text-dark mb-2">
                    {neighborhood.name}
                  </h3>
                  <h4 class="text-lg md:text-xl font-semibold text-primary mb-3">
                    {neighborhood.title}
                  </h4>
                </div>
              </div>

              <p class="text-base md:text-lg text-text/80 mb-6 leading-relaxed">
                {neighborhood.description}
              </p>

              {neighborhood.highlights?.length > 0 && (
                <ul class="space-y-3">
                  {neighborhood.highlights.map((highlight) => (
                    <li class="flex items-start gap-3">
                      <span class="text-primary text-xl flex-shrink-0 mt-1">✓</span>
                      <span class="text-text/90">{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

        <!-- Also Serving -->
        <div
          class="mt-12 text-center bg-light rounded-xl p-8"
          data-aos="fade-up-sm"
        >
          <h3 class="text-xl md:text-2xl font-bold text-dark mb-4">
            Also Proudly Serving
          </h3>
          <p class="text-lg text-text/80">
            All {cityName} neighborhoods and surrounding areas
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Problem Section -->
  <section class="section bg-gradient-to-br from-primary/10 via-white to-accent/10">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <CustomHeading
            as="h2"
            text={`The Challenge of Living in ${cityName}`}
            svgColor="text-primary"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="50"
          >
            {cityName}'s desert environment creates unique challenges for your carpets and home
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            <div class="text-5xl mb-4">🌵</div>
            <h3 class="text-xl font-bold text-dark mb-3">Desert Dust & Dirt</h3>
            <p class="text-text/80">
              {cityName}'s desert location means constant dust infiltration. It settles deep into carpet fibers, creating a gritty, dirty feeling underfoot.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            <div class="text-5xl mb-4">💨</div>
            <h3 class="text-xl font-bold text-dark mb-3">Dust Storms & Allergens</h3>
            <p class="text-text/80">
              Monsoon season brings haboobs that infiltrate homes. Year-round pollen and allergens accumulate in carpets, triggering allergies and respiratory issues.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="200"
          >
            <div class="text-5xl mb-4">☀️</div>
            <h3 class="text-xl font-bold text-dark mb-3">Year-Round Activity</h3>
            <p class="text-text/80">
              {cityName}'s mild winters mean outdoor activities happen all year. Dirt, sand, and debris get tracked inside constantly, wearing down carpets faster.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <p
            class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
            data-aos="fade-up-sm"
          >
            The Perfect Solution
          </p>
          <CustomHeading
            as="h2"
            text="Hot Carbonating Extraction: Ideal for Phoenix Climate"
            svgColor="text-accent"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            Our unique cleaning process is perfectly matched to {cityName}'s desert environment
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">💧</span>
              Lightning-Fast Drying
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Uses about 80% less water than traditional steam cleaning. Combined with {cityName}'s dry climate, your carpets dry in just <strong>1-2 hours</strong> instead of 1-2 days.
            </p>
            <p class="text-text/70">
              Perfect for {cityName} families who need to get back to normal life quickly—no humidity, no dampness, no waiting.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🫧</span>
              Deep Desert Dust Removal
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Millions of carbonating bubbles penetrate deep into carpet fibers, lifting embedded desert dust, dirt, and allergens to the surface where they're extracted.
            </p>
            <p class="text-text/70">
              More effective than steam cleaning at removing the fine desert particulates that {cityName} homes face daily.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🌿</span>
              Allergen Elimination
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Removes <strong>98% of allergens</strong> from carpets—critical for {cityName} residents dealing with year-round pollen, dust mites, and desert allergens.
            </p>
            <p class="text-text/70">
              You can feel good knowing The Natural® contains no harsh chemicals — gentle on kids and pets while being tough on allergens and dirt.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🚫</span>
              No Sticky Residue
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Unlike steam cleaning that leaves soapy residue, our carbonating process uses no soaps or harsh chemicals. No dirt-attracting residue means dirt doesn't stick.
            </p>
            <p class="text-text/70">
              Your carpets stay cleaner longer—essential when {cityName} dust is constantly trying to invade your home.
            </p>
          </div>
        </div>

        <!-- Key Benefits Summary -->
        <div
          class="bg-dark text-white rounded-2xl p-8 md:p-12 text-center"
          data-aos="fade-up-sm"
        >
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            Why {cityName} Families Choose Our Method
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left md:text-center">
            <div>
              <div class="text-4xl mb-3">⚡</div>
              <div class="font-bold text-lg mb-2">Dries in 1-2 Hours</div>
              <div class="text-white/80 text-sm">Perfect for {cityName}'s dry climate</div>
            </div>
            <div>
              <div class="text-4xl mb-3">🏥</div>
              <div class="font-bold text-lg mb-2">98% Allergen Removal</div>
              <div class="text-white/80 text-sm">Breathe easier in your {cityName} home</div>
            </div>
            <div>
              <div class="text-4xl mb-3">🌱</div>
              <div class="font-bold text-lg mb-2">No Harsh Chemicals</div>
              <div class="text-white/80 text-sm">Gentle on desert-loving families & pets</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  {services.length > 0 && (
    <section class="section bg-light">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <p
            class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
            data-aos="fade-up-sm"
          >
            Complete Cleaning Solutions
          </p>
          <CustomHeading
            as="h2"
            text={`Services Throughout ${cityName}`}
            svgColor="text-primary"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p
            class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            Comprehensive cleaning services for every {cityName} neighborhood
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {services.map((service, index) => (
            <div
              class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
              data-aos="fade-up-sm"
              data-aos-delay={index * 50}
            >
              <div class="text-5xl mb-4">
                {serviceEmoji(service.icon)}
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-dark mb-3">
                {service.title}
              </h3>
              <p class="text-text/80 leading-relaxed mb-4">
                {service.description}
              </p>
              {service.link && (
                <a href={service.link} class="text-primary hover:underline font-semibold inline-flex items-center gap-1">
                  Learn More <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          ))}
        </div>

        <div class="text-center mt-12" data-aos="fade-up-sm">
          <CustomButton
            link="tel:4806493663"
            label="Call for Free Quote: (480) 649-3663"
            variant="primary"
            className="text-lg px-8 py-4"
            data_track="phone-click"
            data_track_location={`services-${citySlug}`}
          />
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  <CityTestimonials city={cityName} />

  <!-- ZIP Codes Section -->
  {zipCodes.length > 0 && (
    <section class="section bg-light">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <CustomHeading
            as="h2"
            text={`${cityName} ZIP Codes We Serve`}
            svgColor="text-primary"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
          />
          <p
            class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto mb-8"
            data-aos="fade-up-sm"
            data-aos-delay="50"
          >
            Serving all {cityName} neighborhoods and ZIP codes
          </p>
        </div>

        <!-- All ZIPs -->
        <div
          class="bg-white rounded-xl p-8 md:p-12 shadow-lg max-w-5xl mx-auto"
          data-aos="fade-up-sm"
        >
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {zipCodes.map((item) => (
              <div class="text-center p-3 bg-light rounded-lg hover:bg-primary/10 transition-colors duration-200">
                <div class="font-bold text-primary text-lg">{item.zip}</div>
                <div class="text-sm text-text/70">{item.area}</div>
              </div>
            ))}
          </div>

          <div class="text-center mt-8 pt-8 border-t border-border">
            <p class="text-text/80 mb-4">
              Don't see your ZIP code? We serve all of {cityName}!
            </p>
            <CustomButton
              link="tel:4806493663"
              label="Call to Confirm Service: (480) 649-3663"
              variant="primary"
              className="text-base px-6 py-3"
              data_track="phone-click"
              data_track_location={`zipcode-${citySlug}`}
            />
          </div>

          <!-- Nearby Cities (dynamic from Sanity) -->
          {allCitySlugs.length > 0 && (
            <div class="text-center mt-8 pt-8 border-t border-border" data-aos="fade-up-sm">
              <h3 class="text-xl font-semibold text-dark mb-4">Also Serving Nearby Cities</h3>
              <p class="text-text/80">
                {allCitySlugs.map((c, i) => (
                  <>
                    {i > 0 && " • "}
                    <a href={`/${c.slug}`} class="text-primary hover:underline">{c.city}</a>
                  </>
                ))}
              </p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Why Trust Us Section -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <CustomHeading
            as="h2"
            text={`Why ${cityName} Trusts Brimley's White Glove Chem-Dry`}
            svgColor="text-accent"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
          />
          {data?.whyChooseContent && (
            <p class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto" data-aos="fade-up-sm" data-aos-delay="50">
              {data.whyChooseContent}
            </p>
          )}
        </div>

        <div class="space-y-8">
          <div
            class="flex gap-6 items-start"
            data-aos="fade-right-sm"
          >
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center text-3xl font-bold">
              30+
            </div>
            <div>
              <h3 class="text-2xl font-bold text-dark mb-3">30+ Years Serving {cityName}</h3>
              <p class="text-lg text-text/80 leading-relaxed">
