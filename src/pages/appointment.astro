---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const appointment = (await getEntry(
  "appointment",
  "-index"
)) as CollectionEntry<"appointment">;
const { title, subtitle, description, meta_title, contact_way } =
  appointment.data;

const cta = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="py-20 md:py-32 mt-24 sm:mt-20" data-aos="fade-up-sm">
    <div class="container">
      <div class="mb-8 md:mb-12" data-aos="fade-up-sm">
        <p
          set:html={markdownify(subtitle!)}
          class="text-sm font-semibold tracking-wider uppercase text-accent mb-3 text-left"
          data-aos="fade-up-sm"
        />

        <CustomHeading
          as="h1"
          text={title}
          class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-left"
          dataAos="fade-up-sm"
        />
      </div>
      <div class="row justify-center lg:justify-between g-5">
        <div class="col-12 lg:col-6 order-2 lg:order-1" data-aos="fade-up-sm">
          <div
            class="p-10 bg-light rounded-lg"
            data-aos="fade-up-sm"
            data-aos-delay="100">
            <form action="/api/contact" method="POST" id="appointment-form" data-track="quote-form" data-track-location="appointment-page">
              <div class="row">
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="120">
                    <label for="name" class="form-label"> Name </label>
                    <input
                      id="name"
                      name="name"
                      class="form-input"
                      placeholder="Your Name"
                      type="text"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="140">
                    <label for="email" class="form-label">
                      Email Address <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="email"
                      name="email"
                      class="form-input"
                      placeholder="Your Email Address"
                      type="email"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="160">
                    <label for="phone" class="form-label">
                      Phone <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="phone"
                      name="phone"
                      class="form-input"
                      placeholder="(480) 123-4567"
                      type="tel"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="180">
                    <label for="services" class="form-label"> Message </label>
                    <textarea
                      id="services"
                      name="services"
                      class="form-input"
                      placeholder="What services are you interested in?"
                      rows="9"></textarea>
                  </div>
                </div>
                <div class="col" data-aos="fade-up-sm" data-aos-delay="200">
                  <CustomButton
                    label="Make An Appointment"
                    variant="primary"
                    button_type="submit"
                    data_track="cta-click"
                    data_track_action="submit-appointment"
                  />
                </div>
              </div>
            </form>
          </div>
        </div>

        <div class="col-12 lg:col-6 order-1 lg:order-2" data-aos="fade-up-sm">
          <h2 class="mb-10 h4" data-aos="fade-up-sm" data-aos-delay="100">
            Contact us directly
          </h2>
          {
            contact_way.map((contact, i: number) => (
              <div
                class="flex items-center gap-3 mb-6 last:mb-0"
                data-aos="fade-up-sm"
                data-aos-delay={100 + i * 20}>
                <DynamicIcon
                  icon={contact.icon}
                  className="mr-4 shrink-0 text-primary text-xl"
                />
                <p class="mb-0" set:html={markdownify(contact.value)} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <CallToAction cta={cta.data} />

  <script>
    // Appointment form async submission
    const appointmentForm = document.getElementById('appointment-form') as HTMLFormElement | null;
    if (appointmentForm) {
      const submitButton = appointmentForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const originalButtonText = submitButton?.textContent;

      appointmentForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Submitting...';
        }

        try {
          const response = await fetch(appointmentForm.action, {
            method: 'POST',
            body: new FormData(appointmentForm)
          });

          if (response.ok) {
            window.location.href = '/thank-you';
          } else {
            throw new Error('Submission failed');
          }
        } catch (error) {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText || 'Make An Appointment';
          }
          alert('Something went wrong. Please try again or call us at (303) 252-0517.');
        }
      });
    }
  </script>
</Base>
