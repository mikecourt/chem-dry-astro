---
import BlogCard from "@/components/BlogCard.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import { sanityClient } from "@/lib/sanity";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { PortableText } from "astro-portabletext";
import { getEntry, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(
    `*[_type == "blogPost" && !draft]{ "slug": slug.current }`
  );
  return posts.map((p: any) => ({ params: { single: p.slug } }));
}

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const { single } = Astro.params;
const post = await sanityClient.fetch(
  `*[_type == "blogPost" && slug.current == $slug][0]{
    title,
    "slug": slug.current,
    metaTitle,
    description,
    date,
    "image": image.asset->url,
    categories,
    badge,
    body
  }`,
  { slug: single }
);

const allPosts = await sanityClient.fetch(
  `*[_type == "blogPost" && !draft && slug.current != $slug] | order(date desc) {
    title,
    "slug": slug.current,
    description,
    date,
    categories,
    "image": image.asset->url
  }`,
  { slug: single }
);

// Find similar posts by shared categories (up to 3)
const similarBlogs: any[] = (() => {
  if (!post.categories || post.categories.length === 0) return allPosts.slice(0, 3);
  const byCategory = allPosts.filter((p: any) =>
    p.categories && p.categories.some((c: string) => post.categories.includes(c))
  );
  return byCategory.length > 0 ? byCategory.slice(0, 3) : allPosts.slice(0, 3);
})();

const { title, metaTitle, description, image, date, categories, body } = post;

const baseUrl = config.site.base_url;
const postUrl = `${baseUrl}/blog/${single}`;
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": postUrl,
  "datePublished": date ? new Date(date).toISOString() : undefined,
  "dateModified": date ? new Date(date).toISOString() : undefined,
  "image": image || undefined,
  "author": {
    "@type": "Organization",
    "name": "Brimley's White Glove Chem-Dry",
    "url": baseUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Brimley's White Glove Chem-Dry",
    "url": baseUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${baseUrl}/images/logo.png`,
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl,
  },
};
---

<Base title={title} description={description} meta_title={metaTitle}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <section class="py-20 md:py-32 mt-24 sm:mt-20">
    <div class="container">
      <div class="flex items-center justify-center gap-2.5 mb-6">
        {
          categories && categories.map((category: string, index: number) => (
            <p class="text-primary">
              {humanize(category)}
              {index !== categories.length - 1 && ","}
            </p>
          ))
        }
        {date && (
          <>
            <div class="bg-black/30 h-[3px] w-[3px] rounded-full opacity-100"></div>
            <p class="text-text/50 text-base">
              {dateFormat(date)}
            </p>
          </>
        )}
      </div>
      {
        title && (
          <CustomHeading
            as="h1"
            text={title}
            class="text-h2 md:text-h1 text-balance text-center mb-16"
            dataAos="fade-up-sm"
          />
        )
      }
      <div class="row justify-center">
        <div class="lg:px-25 col-12" data-aos="zoom-in-sm">
          {image && (
            <img
              src={image}
              alt={title}
              width={1256}
              height={719}
              class="w-full aspect-video object-cover rounded-xl mb-11"
              loading="eager"
            />
          )}
        </div>
        <div class="col-12 mb-11">
          <article class="lg:px-25" data-aos="fade-up-sm">
            <div class="content">
              {body && <PortableText value={body} />}
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  {similarBlogs.length > 0 &&


  <hr class="border-border" />

  <section class="section">
    <div class="container">
      <h2 class="text-h3 md:text-h2 mb-16 text-center" data-aos="fade-up-sm">
      Read more articles</h2>
      <div class="row justify-center g-5">
        {
          similarBlogs.map((blog: any, i: number) => (
            <div
            class="xl:col-4 md:col-6 col-12 min-h-full"
            data-aos="zoom-in-sm"
            data-aos-delay={`${i * 100}`}
            >
              <BlogCard blog={blog} index={i} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
}

<CallToAction cta={call_to_action.data} />
</Base>
