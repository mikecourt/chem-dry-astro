---
import BlogCard from "@/components/BlogCard.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { sanityClient } from "@/lib/sanity";

// Page metadata — kept from the original -index.md
const title = "Carpet Cleaning **Tips & Insights**";
const meta_title = "Chem-Dry Blog | Carpet Cleaning Tips, Guides & Home Care Advice";
const description = "Explore expert carpet cleaning tips, home care guides, and industry insights from Phoenix's trusted Chem-Dry professionals.";
const badge = "BLOG";

const allPosts = await sanityClient.fetch(
  `*[_type == "blogPost" && !draft] | order(date desc) {
    title,
    "slug": slug.current,
    description,
    date,
    categories,
    badge,
    "image": image.asset->url,
    metaTitle
  }`
);
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="py-20 md:py-32 mt-24 sm:mt-20">
    <div class="container">
      <div class="mx-auto text-center">
        {
          badge && (
            <p
              class="text-base text-primary mb-6"
              data-aos="fade-up-sm"
              set:html={markdownify(badge)}
            />
          )
        }
        {
          title && (
            <CustomHeading
              as="h1"
              text={title}
              class="text-h2 md:text-h1 mb-16"
              dataAos="fade-up-sm"
              dataAosDelay="100"
            />
          )
        }
      </div>

      <div class="row justify-center g-4">
        {
          allPosts.map((post: any, i: number) => (
            <div
              class="xl:col-4 md:col-6 col-12"
              data-aos="zoom-in-sm"
              data-aos-delay={`${i * 100}`}>
              <BlogCard blog={post} index={i} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
