---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const contact = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;
const { title, subtitle, description, meta_title, image } = contact.data;

const cta = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="py-20 md:py-32 mt-24 sm:mt-20">
    <div class="container">
      <div class="mb-8 md:mb-12">
        <p
          set:html={markdownify(subtitle!)}
          class="text-sm font-semibold tracking-wider uppercase text-accent mb-3 text-left"
          data-aos="fade-up-sm"
        />

        <CustomHeading
          as="h1"
          text={title}
          class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-left"
          dataAos="fade-up-sm"
          dataAosDelay="80"
        />
      </div>
      <div class="row justify-center items-center g-5">
        <div class="col-12 lg:col-6 order-2 lg:order-1">
          <div
            class="p-10 bg-light rounded-lg"
            data-aos="fade-up-sm"
            data-aos-delay="100">
            <form action="/api/contact" method="POST" id="contact-form" data-track="quote-form" data-track-location="contact-page">
              <div class="row">
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="120">
                    <label for="name" class="form-label"> Name </label>
                    <input
                      id="name"
                      name="name"
                      class="form-input"
                      placeholder="Your Name"
                      type="text"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="140">
                    <label for="email" class="form-label">
                      Email Address <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="email"
                      name="email"
                      class="form-input"
                      placeholder="Your Email Address"
                      type="email"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="160">
                    <label for="phone" class="form-label">
                      Phone <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="phone"
                      name="phone"
                      class="form-input"
                      placeholder="(480) 123-4567"
                      type="tel"
                      required
                    />
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="180">
                    <label for="services" class="form-label"> Message </label>
                    <textarea
                      id="services"
                      name="services"
                      class="form-input"
                      placeholder="How can we help you?"
                      rows="9"></textarea>
                  </div>
                </div>
                <div class="col" data-aos="fade-up-sm" data-aos-delay="200">
                  <CustomButton
                    label="Send A Message"
                    variant="primary"
                    button_type="submit"
                    data_track="cta-click"
                    data_track_action="submit-contact"
                  />
                </div>
              </div>
            </form>
          </div>
        </div>

        <div class="col-12 lg:col-6 order-1 lg:order-2" data-aos="fade-up-sm">
          <ImageMod
            src={image!}
            alt={title!}
            width={570}
            height={806}
            class="object-cover mx-auto max-lg:w-3/4"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>
  <CallToAction cta={cta.data} />

  <script>
    // Contact form async submission
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    if (contactForm) {
      const submitButton = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const originalButtonText = submitButton?.textContent;

      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Submitting...';
        }

        try {
          const response = await fetch(contactForm.action, {
            method: 'POST',
            body: new FormData(contactForm)
          });

          if (response.ok) {
            window.location.href = '/thank-you';
          } else {
            throw new Error('Submission failed');
          }
        } catch (error) {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText || 'Send A Message';
          }
          alert('Something went wrong. Please try again or call us at (480) 649-3663.');
        }
      });
    }
  </script>
</Base>
