          <div class="bg-white p-8 rounded-lg shadow-lg">
            <h3 class="text-xl font-semibold text-dark mb-4">Gilbert Zip Codes We Serve</h3>
            <div class="grid grid-cols-2 gap-4 text-base text-text/80">
              <div class="flex gap-2">
                <span class="text-primary">•</span>
