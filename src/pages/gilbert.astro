          link="#contact-form"
          variant="primary"
          data_track="cta-click"
          data_track_location="hero-gilbert"
          data_track_action="navigate-form"
        />
        <CustomButton
          label="(480) 649-3663"
          link="tel:4806493663"
          variant="secondary"
          icon="FaPhone"
          data_track="phone-click"
          data_track_location="hero-gilbert"
        />
      </div>

      <!-- Gilbert Neighborhoods Badge -->
      <div class="mt-6 text-center lg:text-left" data-aos="fade-up-sm" data-aos-delay="250">
        <p class="text-sm text-text/70">
          Proudly serving: <span class="font-semibold text-dark">San Tan Ranch, Val Vista Lakes, Agritopia, Heritage District, Power Ranch</span> & all Gilbert neighborhoods
        </p>
      </div>
    </div>
  </section>

  <!-- Problem Section - Gilbert Specific -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Gilbert Difference
          </p>
          <CustomHeading
            as="h2"
            text="Why Gilbert Families **Need** Professional Carpet Cleaning"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Problem Points -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="100">
          <!-- Growing Families -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Growing Families Need Clean Homes</h3>
            <p class="text-base leading-relaxed text-text/80">
              Gilbert is home to thousands of young families. Kids, pets, and active lifestyles mean your carpets work overtime. You need cleaning that's safe, fast, and actually works.
            </p>
          </div>

          <!-- Desert Dust -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Desert Dust & Valley Allergens</h3>
            <p class="text-base leading-relaxed text-text/80">
              Arizona's desert environment means dust, pollen, and allergens constantly filter into your home. These settle deep in carpet fibers, affecting your family's air quality and health.
            </p>
          </div>

          <!-- Active Lifestyle -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Active Lifestyle Brings In Dirt</h3>
            <p class="text-base leading-relaxed text-text/80">
              From Freestone Park to Gilbert Regional Park, Gilbert families love being outdoors. All that activity means dirt, grass, and grime tracked inside—your carpets need professional help.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section - Perfect for Gilbert Homes -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Perfect Solution for Gilbert Homes
          </p>
          <CustomHeading
            as="h2"
            text="Carpet Cleaning Made for **Gilbert Families**"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Our Hot Carbonating Extraction process was designed with families like yours in mind. It's safe, effective, and perfect for Gilbert's unique needs.
          </p>
        </div>

        <!-- Solution Benefits -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Family Safe -->
          <div class="bg-light p-6 rounded-lg">
            <div class="text-4xl mb-4">✅</div>
            <h3 class="text-xl font-semibold text-dark mb-3">100% Family-Safe Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our green-certified cleaning solution is safe for kids, pets, and everyone in your Gilbert home. No harsh chemicals, no toxic fumes—just clean carpets you can feel good about.
            </p>
          </div>

          <!-- Quick Drying -->
          <div class="bg-light p-6 rounded-lg">
            <div class="text-4xl mb-4">⚡</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Quick Drying for Busy Families</h3>
            <p class="text-base leading-relaxed text-text/80">
              Carpets dry in just 1-2 hours—not 1-2 days. Perfect for Gilbert families who can't wait around. Use your carpets the same day, with no interruption to your busy schedule.
