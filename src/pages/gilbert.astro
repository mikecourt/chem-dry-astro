            </p>
          </div>
        </div>

        <!-- Call-Out Box -->
        <div class="bg-primary/5 border-2 border-primary/20 rounded-lg p-8 mt-12" data-aos="fade-up-sm" data-aos-delay="200">
          <h3 class="text-2xl font-bold text-dark mb-4 text-center">Why Gilbert Residents Choose Brimley's White Glove</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-base text-text/80">
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>Uses about 80% less water than steam cleaning</span>
            </div>
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>Dries faster in Arizona's dry climate</span>
            </div>
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>Safe for children and pets</span>
            </div>
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>Removes stubborn Arizona dust</span>
            </div>
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>No sticky residue that attracts dirt</span>
            </div>
            <div class="flex gap-3">
              <span class="text-primary flex-shrink-0">✓</span>
              <span>Carpets stay cleaner, longer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services in Gilbert Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Complete Cleaning Services
          </p>
          <CustomHeading
            as="h2"
            text="All Services Available in **Gilbert**"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Beyond carpet cleaning, we offer comprehensive cleaning services for every area of your Gilbert home.
          </p>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredServices.map((service, index) => (
            <div
              class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
              data-aos="fade-up-sm"
              data-aos-delay={100 + index * 50}
            >
              <h3 class="text-lg font-semibold text-dark mb-2">{service.data.title}</h3>
              <p class="text-sm text-text/80 mb-4">{service.data.description?.substring(0, 120)}...</p>
