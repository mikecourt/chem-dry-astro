---
import About from "@/components/homepage/About.astro";
import Blog from "@/components/homepage/Blog.astro";
import Customer from "@/components/homepage/Customer.astro";
import Responsibility from "@/components/homepage/Responsibility.astro";
import Testimonial from "@/components/homepage/Testimonial.astro";
import WhiteGlovePromise from "@/layouts/components/homepage/WhiteGlovePromise.astro";
import ComparisonChart from "@/layouts/components/homepage/ComparisonChart.astro";
import ReviewBadges from "@/layouts/components/homepage/ReviewBadges.astro";
import SatisfactionGuarantee from "@/layouts/components/homepage/SatisfactionGuarantee.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Service from "@/layouts/components/services/Service.astro";
import Base from "@/layouts/Base.astro";
import Hero from "@/layouts/components/homepage/Hero.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import { sanityClient, urlFor } from "@/lib/sanity";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const homepage = await sanityClient.fetch(`*[_type == "homepage"][0]`);
const { hero, about, responsibility, customer, testimonial, blog } = homepage;

// Resolve hero image URL from Sanity image reference
const heroImageUrl = hero?.image ? urlFor(hero.image).width(1920).url() : "";

const callToAction = await sanityClient.fetch(`*[_type == "callToAction"][0]`);

// Service section still uses content collections
const serviceIndex = (await getEntry(
  "services",
  "-index"
)) as CollectionEntry<"services">;
const allServices = await getSinglePage("services");
// Show only top 5 services on homepage
const topServices = allServices.slice(0, 5);

const allBlogs = await getSinglePage("blog");

const canonical = "https://whiteglovecarpet.com/";
---

<Base canonical={canonical} preloadImage={heroImageUrl}>
  <SchemaMarkup type="homepage" />
  <Hero hero={{ ...hero, image: heroImageUrl }} />
  <WhiteGlovePromise />
  <ComparisonChart />
  {
    serviceIndex.data.homepage_section_enable && (
      <Service serviceIndex={serviceIndex.data} allServices={topServices} />
    )
  }
  {testimonial?.enable && <Testimonial testimonial={testimonial} />}
  <ReviewBadges reviews={hero?.reviews ?? []} />
  {blog?.enable && <Blog blog={blog} allBlogs={allBlogs} />}
  <SatisfactionGuarantee />
  {about?.enable && <About about={about} />}
  <CallToAction cta={callToAction} />
</Base>
