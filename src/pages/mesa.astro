---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const title = "Carpet Cleaning Mesa AZ";
const meta_title = "Carpet Cleaning Mesa AZ | Professional Service Since 1995 | Brimley's";
const description = "Professional carpet cleaning in Mesa, AZ. Hot Carbonating Extraction, 1-2 hour dry time. Serving Mesa families for 25+ years. Free quote! (480) 649-3663";
---

<Base title={title} description={description} meta_title={meta_title}>
  <SchemaMarkup type="local" serviceName="Carpet Cleaning" city="Mesa" state="Arizona" />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.jpg'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
      >
        Professional Carpet Cleaning in Mesa, Arizona
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Mesa's **Trusted** Carpet<br class='hidden lg:block' /> Cleaning Service Since 1995"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        Local, family-owned business serving Mesa families with deeper, drier carpet cleaning that's safe for kids and pets.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="150">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🏠
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Serving Mesa Since 1995</div>
            <div class="text-xs md:text-sm text-gray-600">25+ years in your community</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            👨‍👩‍👧‍👦
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Local Family Business</div>
            <div class="text-xs md:text-sm text-gray-600">Not a franchise - we live here too</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ⏱️
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">1-2 Hour Dry Time</div>
            <div class="text-xs md:text-sm text-gray-600">Perfect for Arizona's climate</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            📍
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">All Mesa Zip Codes</div>
            <div class="text-xs md:text-sm text-gray-600">East Mesa, West Mesa & more</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
        <CustomButton
          label="Get My Free Mesa Estimate"
          link="#contact-form"
          variant="primary"
        />
        <CustomButton
          label="(480) 649-3663"
          link="tel:+14806493663"
          variant="secondary"
          icon="FaPhone"
        />
      </div>

      <!-- Service Areas Note -->
      <p class="text-sm text-text/70 mt-4 text-center lg:text-left" data-aos="fade-up-sm" data-aos-delay="250">
        Proudly serving East Mesa, West Mesa, Red Mountain, Superstition Springs, and all Mesa neighborhoods
      </p>
    </div>
  </section>

  <!-- Problem Section: Why Mesa Residents Need Professional Carpet Cleaning -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Mesa Challenge
          </p>
          <CustomHeading
            as="h2"
            text="Why Mesa Carpets Need **Special** Care"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Living in Mesa means dealing with unique carpet challenges that most cleaning companies don't understand.
          </p>
        </div>

        <!-- Three Challenges -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Challenge 1 -->
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <div class="w-16 h-16 rounded-full bg-orange-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2 text-center">Desert Dust & Dirt</h3>
            <p class="text-base leading-relaxed text-text/80 text-center">
              Mesa's desert environment means constant fine dust and dirt tracked into your home. This gritty soil embeds deep in carpet fibers and wears them down over time.
            </p>
          </div>

          <!-- Challenge 2 -->
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2 text-center">High-Traffic Outdoor Lifestyle</h3>
            <p class="text-base leading-relaxed text-text/80 text-center">
              Mesa families love the outdoors - hiking Red Mountain, visiting Riverview Park, enjoying Superstition Springs. All that activity means more dirt and wear on your carpets.
            </p>
          </div>

          <!-- Challenge 3 -->
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2 text-center">Pets & Allergens</h3>
            <p class="text-base leading-relaxed text-text/80 text-center">
              Mesa's pet-friendly community is wonderful, but pet dander, accidents, and outdoor allergens get trapped in carpets. Traditional cleaning methods can't remove them all.
            </p>
          </div>
        </div>

        <!-- Bottom CTA -->
        <div class="text-center mt-12" data-aos="fade-up-sm" data-aos-delay="200">
          <p class="text-lg text-text/80 mb-6">
            After 25+ years serving Mesa homes, we know exactly what your carpets are up against.
          </p>
          <CustomButton
            label="Get Your Free Mesa Estimate"
            link="#contact-form"
            variant="primary"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section: Chem-Dry Process Perfect for Mesa -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Chem-Dry Advantage in Mesa
          </p>
          <CustomHeading
            as="h2"
            text="Perfect for **Arizona's** Climate"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <h3 class="text-2xl font-semibold text-dark mb-4" data-aos="fade-up-sm" data-aos-delay="100">
            Why Mesa Homeowners Choose Hot Carbonating Extraction
          </h3>
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="150">
            Traditional steam cleaning uses gallons of water that take days to dry - a recipe for disaster in Mesa's climate. Our revolutionary Hot Carbonating Extraction (HCE) process is engineered for Arizona living.
          </p>
        </div>

        <!-- Benefits for Mesa -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" data-aos="fade-up-sm" data-aos-delay="200">
          <!-- Benefit 1 -->
          <div class="bg-primary/5 p-6 rounded-lg border-2 border-primary/20">
            <h4 class="text-lg font-semibold text-dark mb-3 flex items-center gap-2">
              <span class="text-primary">✓</span>
              Lightning-Fast Dry Time (1-2 Hours)
            </h4>
            <p class="text-base leading-relaxed text-text/80">
              In Mesa's dry heat, our low-moisture process means your carpets are ready for foot traffic in just 1-2 hours. No more keeping the family off the carpets all day.
            </p>
          </div>

          <!-- Benefit 2 -->
          <div class="bg-primary/5 p-6 rounded-lg border-2 border-primary/20">
            <h4 class="text-lg font-semibold text-dark mb-3 flex items-center gap-2">
              <span class="text-primary">✓</span>
              Removes Desert Dust & Allergens
            </h4>
            <p class="text-base leading-relaxed text-text/80">
              Our carbonating bubbles lift embedded desert dust and allergens from deep in the carpet fibers - removing up to 98% of allergens and 89% of airborne bacteria.
            </p>
          </div>

          <!-- Benefit 3 -->
          <div class="bg-primary/5 p-6 rounded-lg border-2 border-primary/20">
            <h4 class="text-lg font-semibold text-dark mb-3 flex items-center gap-2">
              <span class="text-primary">✓</span>
              Safe for Mesa Families & Pets
            </h4>
            <p class="text-base leading-relaxed text-text/80">
              The Natural® is green-certified, non-toxic, and contains no harsh chemicals. Perfect for homes with kids, pets, and family members with sensitivities.
            </p>
          </div>

          <!-- Benefit 4 -->
          <div class="bg-primary/5 p-6 rounded-lg border-2 border-primary/20">
            <h4 class="text-lg font-semibold text-dark mb-3 flex items-center gap-2">
              <span class="text-primary">✓</span>
              Carpets Stay Cleaner Longer
            </h4>
            <p class="text-base leading-relaxed text-text/80">
              Unlike steam cleaning that leaves sticky residue attracting dirt, our process leaves no residue. Your carpets resist re-soiling and stay cleaner longer.
            </p>
          </div>
        </div>

        <!-- Process Explanation -->
        <div class="bg-light p-8 rounded-lg" data-aos="fade-up-sm" data-aos-delay="250">
          <h4 class="text-xl font-semibold text-dark mb-4">How It Works</h4>
          <p class="text-base leading-relaxed text-text/80 mb-6">
            The process used by Chem-Dry uses millions of carbonating bubbles - like sparkling water - to penetrate deep into your carpet fibers. These bubbles explode dirt and grime to the surface where our powerful extraction equipment whisks it away. The result? Carpets that are truly clean, not just surface-level clean.
          </p>

          <!-- Diagram -->
          <div class="bg-white p-8 rounded-lg border-2 border-gray-200">
            <img
              src="/images/powerhead-graphic.webp"
              alt="Diagram showing carbonation bubbles lifting dirt particles from carpet fibers"
              class="w-full h-auto rounded"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services in Mesa -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Our Mesa Services
          </p>
          <CustomHeading
            as="h2"
            text="Complete Cleaning **Solutions** for Mesa Homes"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            From Red Mountain to Superstition Springs, we bring the same white-glove service to every Mesa home.
          </p>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Carpet Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="text-4xl mb-4">🏠</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Carpet Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Deep-clean your carpets with our Hot Carbonating Extraction process. Removes desert dust, allergens, and stubborn stains while drying in just 1-2 hours.
            </p>
            <a href="/services/carpet-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Upholstery Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="text-4xl mb-4">🛋️</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Upholstery Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Refresh your sofas, chairs, and other upholstered furniture. Safe for all fabric types and dries quickly in Mesa's climate.
            </p>
            <a href="/services/upholstery-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Tile & Grout Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="text-4xl mb-4">✨</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Tile & Grout Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Restore the beauty of your tile floors and eliminate bacteria hiding in grout lines. Perfect for Mesa kitchens, bathrooms, and entryways.
            </p>
            <a href="/services/tile-and-grout-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Pet Urine Removal -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="250">
            <div class="text-4xl mb-4">🐾</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Pet Urine Removal</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Our P.U.R.T.® treatment permanently eliminates pet urine odors and stains at the molecular level. No more masking - complete odor removal.
            </p>
            <a href="/services/pet-urine-removal" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Area Rug Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="300">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Area Rug Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Specialized cleaning for Persian, Oriental, and modern area rugs. We protect your investment while removing years of embedded soil.
            </p>
            <a href="/services/area-rug-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Specialty Stain Removal -->
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow" data-aos="fade-up-sm" data-aos-delay="350">
            <div class="text-4xl mb-4">🎯</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Specialty Stain Removal</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Tough stains like wine, coffee, and ink require special treatment. Our technicians are trained in advanced stain removal techniques.
            </p>
            <a href="/services/specialty-stain-removal" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials from Mesa Residents -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Mesa Testimonials
          </p>
          <CustomHeading
            as="h2"
            text="Hear From Your **Mesa** Neighbors"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Don't just take our word for it - hear what Mesa homeowners say about our service.
          </p>
        </div>

        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Testimonial 1 - Carol McGowan -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="flex gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-base leading-relaxed text-text/80 mb-4 italic">
              "As a repeat customer, I was surprised they still had all my information in their system even though it had been five years since their last visit. Ryan was very friendly, neat, and professional. I was concerned that some of the wheelchair dirt tracks might not clean well, but was I surprised! My carpets cleaned up real nice. Highly recommend Brimley's White Glove Chem Dry for clean carpets!"
            </p>
            <p class="text-sm font-semibold text-dark">Carol McGowan, Mesa</p>
            <p class="text-xs text-text/60">CustomerLobby Review</p>
          </div>

          <!-- Testimonial 2 - Jennifer Austin-Bell -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="flex gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-base leading-relaxed text-text/80 mb-4 italic">
              "Brimley's White Glove Chem-Dry were fantastic. They are located in Mesa, Arizona. They cleaned our carpets, area rugs and our sofas. James Weiss was fantastic. He was professional, friendly, courteous, diligent and the best at his business. We would recommend this company and James to anyone who wants excellent service and a job very well done."
            </p>
            <p class="text-sm font-semibold text-dark">Jennifer Austin-Bell, Mesa</p>
            <p class="text-xs text-text/60">Facebook Review</p>
          </div>

          <!-- Testimonial 3 - Cathy J. -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="flex gap-1 mb-4">
