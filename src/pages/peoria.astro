---
import Base from "@/layouts/Base.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import TrustBar from "@/components/TrustBar.astro";
import CallToAction from "@/partials/CallToAction.astro";
import CityTestimonials from "@/components/CityTestimonials.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntry, type CollectionEntry } from "astro:content";

const meta_title = "Carpet Cleaning Peoria AZ | Vistancia, Lake Pleasant | Brimley's";
const meta_description = "Carpet cleaning Peoria AZ - Vistancia, Fletcher Heights, Lake Pleasant area & more. Hot Carbonating Extraction dries in 1-2 hrs. 25+ yrs experience. Free quote: (480) 649-3663";
const canonical = "https://whiteglovecarpet.com/peoria";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

// Peoria neighborhoods
const neighborhoods = [
  {
    name: "Vistancia",
    title: "Vistancia's Trusted Carpet Cleaning Service",
    description: "Serving Vistancia families with premium carpet care. This beautiful master-planned community deserves the best—and that's exactly what we deliver with our gentle, effective Hot Carbonating Extraction process.",
    highlights: [
      "Experience with Vistancia homes",
      "Fast response to Northwest Peoria",
      "Pet and kid-friendly solutions",
      "Know the community intimately"
    ],
    icon: "FaHome"
  },
  {
    name: "Fletcher Heights",
    title: "Premium Service for Fletcher Heights",
    description: "Fletcher Heights families trust us for reliable, professional carpet cleaning. We understand the needs of this established community and deliver service that keeps your home healthy, clean, and ready for guests.",
    highlights: [
      "Established community expertise",
      "Quick service to Fletcher Heights",
      "Spring training guest-ready results",
      "Trusted by local homeowners"
    ],
    icon: "FaStar"
  },
  {
    name: "Lake Pleasant Heights",
    title: "Lake Pleasant Area Specialists",
    description: "Living near Lake Pleasant means sand and dust get tracked in regularly. Our specialized cleaning removes embedded sand and debris while drying quickly so you can get back to enjoying the outdoors.",
    highlights: [
      "Expert at removing lake sand and dust",
      "Fast 1-2 hour dry time",
      "Recreation-ready turnaround",
      "Deep clean for active families"
    ],
    icon: "FaCrown"
  },
  {
    name: "Sunrise Mountain",
    title: "Serving Sunrise Mountain Communities",
    description: "Sunrise Mountain area families trust us for reliable, family-focused carpet cleaning. We understand the needs of growing families and deliver service that keeps your home healthy and clean.",
    highlights: [
      "Family-focused service",
      "Quick response times",
      "Pet-friendly cleaning solutions",
      "Safe for kids and pets"
    ],
    icon: "FaMountain"
  }
];

// Peoria services
const services = [
  {
    title: "Carpet Cleaning",
    description: "Hot Carbonating Extraction removes desert dust, lake sand, and allergens from your Peoria home's carpets.",
    icon: "FaHouseUser",
    link: "/services/carpet-cleaning"
  },
  {
    title: "Tile & Grout Cleaning",
    description: "Restore tile floors common in Peoria homes. Remove years of buildup from grout lines.",
    icon: "FaTh",
    link: "/services/tile-and-grout-cleaning"
  },
  {
    title: "Upholstery Cleaning",
    description: "Refresh furniture that bears the brunt of Northwest Valley dust and daily family life.",
    icon: "FaCouch",
    link: "/services/upholstery-cleaning"
  },
  {
    title: "Pet Odor Removal",
    description: "Eliminate pet odors and stains with our P.U.R.T.® treatment. Safe for Peoria's pet-loving families.",
    icon: "FaPaw",
    link: "/services"
  },
  {
    title: "Area Rug Cleaning",
    description: "Specialized cleaning for the rugs that define your Peoria home's style.",
    icon: "FaRug",
    link: "/services"
  },
  {
    title: "Allergen Removal",
    description: "Critical in Peoria's Northwest Valley climate. Remove dust, pollen, and allergens that accumulate year-round.",
    icon: "FaLeaf",
    link: "/services/carpet-cleaning"
  }
];

// Peoria ZIP codes
const peoriaZips = [
  { zip: "85345", area: "Old Town Peoria" },
  { zip: "85380", area: "Central Peoria" },
  { zip: "85381", area: "Central Peoria" },
  { zip: "85382", area: "North Peoria, Vistancia" },
  { zip: "85383", area: "Far North Peoria" },
];

// FAQ items
const faqs = [
  {
    question: "Do you serve the Vistancia area?",
    answer: "Absolutely! Vistancia is one of our primary service areas in Peoria. We've been serving Vistancia families for years and know the community well. Whether you're in the main Vistancia development or nearby neighborhoods, we provide fast, reliable carpet cleaning service. We serve Vistancia primarily in ZIP code 85382."
  },
  {
    question: "Do you cover the Lake Pleasant area?",
    answer: "Yes! We serve all areas near Lake Pleasant Regional Park. We understand that recreation near the lake means extra sand and dust tracked into your home. Our deep cleaning process removes embedded sand and debris, and our fast dry times mean you won't miss a day of fun. We also serve nearby cities like <a href=\"/phoenix\" class=\"text-primary hover:underline\">Phoenix</a> and <a href=\"/glendale\" class=\"text-primary hover:underline\">Glendale</a>."
  },
  {
    question: "How does the fast dry time work in Peoria's climate?",
    answer: "Peoria's warm, dry Northwest Valley climate is perfect for our <a href=\"/services/carpet-cleaning\" class=\"text-primary hover:underline\">Hot Carbonating Extraction</a> process! Because we use about 80% less water than traditional steam cleaning, your carpets dry in just 1-2 hours. This means you can get back to your normal routine the same day, without the humidity and dampness of traditional steam cleaning."
  },
  {
    question: "Can you handle new construction dust?",
    answer: "Yes, this is a common need in Peoria! With all the new development in the Northwest Valley, construction dust is a major concern for homeowners. Our Hot Carbonating Extraction process is excellent at removing fine construction particulates from carpet fibers, leaving your new home truly move-in ready."
  },
  {
    question: "What makes your service different for Peoria homes?",
    answer: "We understand Peoria's unique challenges: Lake Pleasant recreation tracking in sand and dust, new construction dust from ongoing development, and the growing family community with kids and pets. Our Hot Carbonating Extraction is perfect for Peoria's climate—it deep cleans without soaking carpets, removes embedded debris effectively, and dries incredibly fast."
  },
  {
    question: "Can you remove desert dust and allergens?",
    answer: "Yes! This is one of our specialties. Our Hot Carbonating Extraction process removes 98% of allergens from carpets, including the desert dust, pollen, and particulates that are constant challenges in Peoria. We also offer dedicated allergen removal treatments that are especially important for Northwest Valley residents dealing with year-round allergy triggers."
  },
  {
    question: "Do you offer same-day service in Peoria?",
    answer: "In many cases, yes! We understand that Peoria families have busy schedules, especially during Spring Training season when you might be hosting guests. Depending on our technicians' availability in your Peoria neighborhood, we can often accommodate same-day or next-day appointments. Call us at (480) 649-3663 to check availability."
  },
  {
    question: "What neighborhoods do you serve in Peoria?",
    answer: "We serve all Peoria neighborhoods with the same high-quality service, including Vistancia, Fletcher Heights, Lake Pleasant Heights, Sunrise Mountain, Westwing Mountain, Old Town Peoria, and more. Whether you're in the established communities or the newer developments, you'll receive the same exceptional white-glove service."
  }
];
---

<Base meta_title={meta_title} description={meta_description} canonical={canonical}>
  <SchemaMarkup type="city" city="Peoria" state="Arizona" postalCodes={["85345", "85380", "85381", "85382", "85383"]} faqs={faqs} />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-32 lg:py-40 relative mb-0 bg-gradient-to-br from-primary/5 via-white to-accent/5"
  >
    <div class="container mx-auto px-4">
      <div class="text-center max-w-5xl mx-auto">
        <!-- Subtitle -->
        <p
          class="text-accent font-semibold text-lg md:text-xl mb-4 tracking-wide uppercase"
          data-aos="fade-up-sm"
        >
          Carpet Cleaning Peoria, Arizona
        </p>

        <!-- Main Heading -->
        <CustomHeading
          as="h1"
          text="Professional Carpet Cleaning in Peoria, Arizona"
          svgColor="text-primary"
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />

        <!-- Subheading -->
        <p
          class="text-xl md:text-2xl text-text/80 mb-8 font-medium"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Serving Peoria Neighborhoods for 25+ Years
        </p>

        <!-- Trust Badges - Peoria Neighborhoods Focus -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 max-w-4xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="150"
        >
          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              🏠
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Vistancia</div>
              <div class="text-xs md:text-sm text-gray-600">Master-Planned Community</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              ⭐
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Fletcher Heights</div>
              <div class="text-xs md:text-sm text-gray-600">Established Community</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              🏞️
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Lake Pleasant</div>
              <div class="text-xs md:text-sm text-gray-600">Recreation Ready</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              ⛰️
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Sunrise Mountain</div>
              <div class="text-xs md:text-sm text-gray-600">Family Focused</div>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row justify-center items-center gap-4"
          data-aos="fade-up-sm"
          data-aos-delay="200"
        >
          <CustomButton
            link="tel:4806493663"
            label="Call (480) 649-3663"
            variant="primary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="phone-click"
            data_track_location="hero-peoria"
          />
          <CustomButton
            link="/appointment"
            label="Schedule Online"
            variant="secondary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="cta-click"
            data_track_location="hero-peoria"
            data_track_action="navigate-appointment"
          />
        </div>

        <!-- Additional Trust Points -->
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-text/70">
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Dries in 1-2 Hours</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Safe for Kids & Pets</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Family Owned Since 1995</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>All Peoria Neighborhoods</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Peoria Neighborhoods Section - FEATURED -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <p
          class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
          data-aos="fade-up-sm"
        >
          Local Expertise
        </p>
        <CustomHeading
          as="h2"
          text="Peoria Neighborhoods We Serve"
          svgColor="text-accent"
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />
        <p
          class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          We're not just in Peoria—we're of Peoria. Our technicians know your neighborhood and understand what your home needs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {neighborhoods.map((neighborhood, index) => (
          <div
            class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 lg:p-10 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
            data-aos="fade-up-sm"
            data-aos-delay={index * 100}
          >
            <div class="flex items-start gap-4 mb-6">
              <div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white text-3xl flex-shrink-0">
                {neighborhood.icon === "FaHome" && "🏠"}
                {neighborhood.icon === "FaStar" && "⭐"}
                {neighborhood.icon === "FaCrown" && "🏞️"}
                {neighborhood.icon === "FaMountain" && "⛰️"}
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold text-dark mb-2">
                  {neighborhood.name}
                </h3>
                <h4 class="text-lg md:text-xl font-semibold text-primary mb-3">
                  {neighborhood.title}
                </h4>
              </div>
            </div>

            <p class="text-base md:text-lg text-text/80 mb-6 leading-relaxed">
              {neighborhood.description}
            </p>

            <ul class="space-y-3">
              {neighborhood.highlights.map((highlight) => (
                <li class="flex items-start gap-3">
                  <span class="text-primary text-xl flex-shrink-0 mt-1">✓</span>
                  <span class="text-text/90">{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Also Serving -->
      <div
        class="mt-12 text-center bg-light rounded-xl p-8"
        data-aos="fade-up-sm"
      >
        <h3 class="text-xl md:text-2xl font-bold text-dark mb-4">
          Also Proudly Serving
        </h3>
        <p class="text-lg text-text/80">
          Westwing Mountain • Old Town Peoria • North Peoria • Glendale border • All Peoria ZIP codes
        </p>
      </div>
    </div>
  </section>

  <!-- Problem Section - Peoria Challenges -->
  <section class="section bg-gradient-to-br from-primary/10 via-white to-accent/10">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <CustomHeading
            as="h2"
            text="The Challenge of Living in Peoria"
            svgColor="text-primary"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="50"
          >
            Peoria's Northwest Valley location creates unique challenges for your carpets and home
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            <div class="text-5xl mb-4">🏞️</div>
            <h3 class="text-xl font-bold text-dark mb-3">Lake Pleasant Recreation</h3>
            <p class="text-text/80">
              Living near Lake Pleasant means constant outdoor fun—but also sand, dirt, and dust tracked into your home. This fine debris settles deep in carpet fibers.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            <div class="text-5xl mb-4">🏗️</div>
            <h3 class="text-xl font-bold text-dark mb-3">New Construction Dust</h3>
            <p class="text-text/80">
              Peoria's growth means ongoing construction throughout the Northwest Valley. Construction dust infiltrates homes and settles into carpets, creating a gritty feeling underfoot.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="200"
          >
            <div class="text-5xl mb-4">⚾</div>
            <h3 class="text-xl font-bold text-dark mb-3">Spring Training Season</h3>
            <p class="text-text/80">
              Hosting visitors during Spring Training? More foot traffic means more wear on your carpets. Peoria families need their homes guest-ready on short notice.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section - Perfect for Peoria -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <p
            class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
            data-aos="fade-up-sm"
          >
            The Perfect Solution
          </p>
          <CustomHeading
            as="h2"
            text="Hot Carbonating Extraction: Ideal for Peoria Climate"
            svgColor="text-accent"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            Our unique cleaning process is perfectly matched to Peoria's Northwest Valley environment
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">💧</span>
              Lightning-Fast Drying
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Uses about 80% less water than traditional steam cleaning. Combined with Peoria's dry climate, your carpets dry in just <strong>1-2 hours</strong> instead of 1-2 days.
            </p>
            <p class="text-text/70">
              Perfect for Peoria families who need to get back to normal life quickly—no humidity, no dampness, no waiting.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🫧</span>
              Deep Sand & Dust Removal
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Millions of carbonating bubbles penetrate deep into carpet fibers, lifting embedded lake sand, construction dust, and allergens to the surface where they're extracted.
            </p>
            <p class="text-text/70">
              More effective than steam cleaning at removing the fine particulates that Peoria homes face from Lake Pleasant and ongoing development.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🌿</span>
              Allergen Elimination
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Removes <strong>98% of allergens</strong> from carpets—critical for Peoria residents dealing with year-round pollen, dust mites, and Northwest Valley allergens.
            </p>
            <p class="text-text/70">
              Our Green Certified solution, The Natural®, is safe for kids and pets while being tough on allergens and dirt.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🚫</span>
              No Sticky Residue
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Unlike steam cleaning that leaves soapy residue, our carbonating process uses no soaps or harsh chemicals. No dirt-attracting residue means carpets stay cleaner longer.
            </p>
            <p class="text-text/70">
              Essential when Peoria dust and sand are constantly trying to invade your home—your carpets stay cleaner longer.
            </p>
          </div>
        </div>

        <!-- Key Benefits Summary -->
        <div
          class="bg-dark text-white rounded-2xl p-8 md:p-12 text-center"
          data-aos="fade-up-sm"
        >
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            Why Peoria Families Choose Our Method
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left md:text-center">
            <div>
              <div class="text-4xl mb-3">⚡</div>
              <div class="font-bold text-lg mb-2">Dries in 1-2 Hours</div>
              <div class="text-white/80 text-sm">Perfect for Peoria's dry climate</div>
            </div>
            <div>
              <div class="text-4xl mb-3">🏥</div>
              <div class="font-bold text-lg mb-2">98% Allergen Removal</div>
              <div class="text-white/80 text-sm">Breathe easier in your Peoria home</div>
            </div>
            <div>
              <div class="text-4xl mb-3">🌱</div>
              <div class="font-bold text-lg mb-2">Green Certified & Safe</div>
              <div class="text-white/80 text-sm">Safe for active families & pets</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Throughout Peoria -->
  <section class="section bg-light">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <p
          class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
          data-aos="fade-up-sm"
        >
          Complete Cleaning Solutions
        </p>
        <CustomHeading
          as="h2"
          text="Services Throughout Peoria"
          svgColor="text-primary"
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />
        <p
          class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Comprehensive cleaning services for every Peoria neighborhood
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <div
            class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
            data-aos="fade-up-sm"
            data-aos-delay={index * 50}
          >
            <div class="text-5xl mb-4">
              {service.icon === "FaHouseUser" && "🏠"}
