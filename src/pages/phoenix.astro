---

<Base meta_title={meta_title} description={meta_description} canonical={canonical}>
  <SchemaMarkup type="city" city="Phoenix" state="Arizona" postalCodes={["85044", "85045", "85048", "85003", "85006", "85016", "85018", "85020"]} faqs={faqs} />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-32 lg:py-40 relative mb-0 bg-gradient-to-br from-primary/5 via-white to-accent/5"
  >
    <div class="container mx-auto px-4">
      <div class="text-center max-w-5xl mx-auto">
        <!-- Subtitle -->
        <p
          class="text-accent font-semibold text-lg md:text-xl mb-4 tracking-wide uppercase"
          data-aos="fade-up-sm"
        >
          Carpet Cleaning Phoenix, Arizona
        </p>

        <!-- Main Heading -->
        <CustomHeading
          as="h1"
          text="Professional Carpet Cleaning in Phoenix, Arizona"
          svgColor="text-primary"
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />

        <!-- Subheading -->
        <p
          class="text-xl md:text-2xl text-text/80 mb-8 font-medium"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Serving Phoenix Neighborhoods Since 1995
        </p>

        <!-- Trust Badges - Phoenix Neighborhoods Focus -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 max-w-4xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="150"
        >
          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              🏠
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Ahwatukee</div>
              <div class="text-xs md:text-sm text-gray-600">Trusted for 25+ Years</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              ⭐
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Arcadia</div>
              <div class="text-xs md:text-sm text-gray-600">Premium Service</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              👑
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">Biltmore</div>
              <div class="text-xs md:text-sm text-gray-600">White Glove Service</div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 bg-white p-4 rounded-lg shadow-sm border border-border">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
              ⛰️
            </div>
            <div class="text-left">
              <div class="font-bold text-dark text-sm md:text-base">South Mountain</div>
              <div class="text-xs md:text-sm text-gray-600">Family Focused</div>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row justify-center items-center gap-4"
          data-aos="fade-up-sm"
          data-aos-delay="200"
        >
          <CustomButton
            link="tel:4806493663"
            label="Call (480) 649-3663"
            variant="primary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="phone-click"
            data_track_location="hero-phoenix"
          />
          <CustomButton
            link="/appointment"
            label="Schedule Online"
            variant="secondary"
            className="w-full sm:w-auto text-lg px-8 py-4"
            data_track="cta-click"
            data_track_location="hero-phoenix"
            data_track_action="navigate-appointment"
          />
        </div>

        <!-- Additional Trust Points -->
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-text/70">
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Dries in 1-2 Hours</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Safe for Kids & Pets</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>Family Owned Since 1995</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>All Phoenix Neighborhoods</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Phoenix Neighborhoods Section - FEATURED -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <p
          class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
          data-aos="fade-up-sm"
        >
          Local Expertise
        </p>
        <CustomHeading
          as="h2"
          text="Phoenix Neighborhoods We Serve"
          svgColor="text-accent"
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />
        <p
          class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          We're not just in Phoenix—we're of Phoenix. Our technicians know your neighborhood and understand what your home needs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {neighborhoods.map((neighborhood, index) => (
          <div
            class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 lg:p-10 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
            data-aos="fade-up-sm"
            data-aos-delay={index * 100}
          >
            <div class="flex items-start gap-4 mb-6">
              <div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white text-3xl flex-shrink-0">
                {neighborhood.icon === "FaHome" && "🏠"}
                {neighborhood.icon === "FaStar" && "⭐"}
                {neighborhood.icon === "FaCrown" && "👑"}
                {neighborhood.icon === "FaMountain" && "⛰️"}
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold text-dark mb-2">
                  {neighborhood.name}
                </h3>
                <h4 class="text-lg md:text-xl font-semibold text-primary mb-3">
                  {neighborhood.title}
                </h4>
              </div>
            </div>

            <p class="text-base md:text-lg text-text/80 mb-6 leading-relaxed">
              {neighborhood.description}
            </p>

            <ul class="space-y-3">
              {neighborhood.highlights.map((highlight) => (
                <li class="flex items-start gap-3">
                  <span class="text-primary text-xl flex-shrink-0 mt-1">✓</span>
                  <span class="text-text/90">{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Also Serving -->
      <div
        class="mt-12 text-center bg-light rounded-xl p-8"
        data-aos="fade-up-sm"
      >
        <h3 class="text-xl md:text-2xl font-bold text-dark mb-4">
          Also Proudly Serving
        </h3>
        <p class="text-lg text-text/80">
          North Phoenix • Central Phoenix • Camelback • Paradise Valley (border) • Desert Ridge • Maryvale • Laveen • Encanto • Downtown Phoenix • All Phoenix ZIP codes
        </p>
      </div>
    </div>
  </section>

  <!-- Problem Section - Phoenix Challenges -->
  <section class="section bg-gradient-to-br from-primary/10 via-white to-accent/10">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <CustomHeading
            as="h2"
            text="The Challenge of Living in Phoenix"
            svgColor="text-primary"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="50"
          >
            Phoenix's desert environment creates unique challenges for your carpets and home
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            <div class="text-5xl mb-4">🌵</div>
            <h3 class="text-xl font-bold text-dark mb-3">Desert Dust & Dirt</h3>
            <p class="text-text/80">
              Phoenix's desert location means constant dust infiltration. It settles deep into carpet fibers, creating a gritty, dirty feeling underfoot.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            <div class="text-5xl mb-4">💨</div>
            <h3 class="text-xl font-bold text-dark mb-3">Dust Storms & Allergens</h3>
            <p class="text-text/80">
              Monsoon season brings haboobs that infiltrate homes. Year-round pollen and allergens accumulate in carpets, triggering allergies and respiratory issues.
            </p>
          </div>

          <div
            class="bg-white rounded-xl p-6 shadow-lg text-center"
            data-aos="fade-up-sm"
            data-aos-delay="200"
          >
            <div class="text-5xl mb-4">☀️</div>
            <h3 class="text-xl font-bold text-dark mb-3">Year-Round Activity</h3>
            <p class="text-text/80">
              Phoenix's mild winters mean outdoor activities happen all year. Dirt, sand, and debris get tracked inside constantly, wearing down carpets faster.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section - Perfect for Phoenix -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <p
            class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
            data-aos="fade-up-sm"
          >
            The Perfect Solution
          </p>
          <CustomHeading
            as="h2"
            text="Hot Carbonating Extraction: Ideal for Phoenix Climate"
            svgColor="text-accent"
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p
            class="text-lg md:text-xl text-text/80"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            Our unique cleaning process is perfectly matched to Phoenix's desert environment
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">💧</span>
              Lightning-Fast Drying
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Uses about 80% less water than traditional steam cleaning. Combined with Phoenix's dry climate, your carpets dry in just <strong>1-2 hours</strong> instead of 1-2 days.
            </p>
            <p class="text-text/70">
              Perfect for Phoenix families who need to get back to normal life quickly—no humidity, no dampness, no waiting.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🫧</span>
              Deep Desert Dust Removal
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Millions of carbonating bubbles penetrate deep into carpet fibers, lifting embedded desert dust, dirt, and allergens to the surface where they're extracted.
            </p>
            <p class="text-text/70">
              More effective than steam cleaning at removing the fine desert particulates that Phoenix homes face daily.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-primary/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-right-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🌿</span>
              Allergen Elimination
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Removes <strong>98% of allergens</strong> from carpets—critical for Phoenix residents dealing with year-round pollen, dust mites, and desert allergens.
            </p>
            <p class="text-text/70">
              Our Green Certified solution, The Natural®, is safe for kids and pets while being tough on allergens and dirt.
            </p>
          </div>

          <div
            class="bg-gradient-to-br from-accent/5 to-white rounded-xl p-8 shadow-lg border border-border"
            data-aos="fade-left-sm"
            data-aos-delay="50"
          >
            <h3 class="text-2xl font-bold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🚫</span>
              No Sticky Residue
            </h3>
            <p class="text-lg text-text/80 mb-4">
              Unlike steam cleaning that leaves soapy residue, our carbonating process uses no soaps or harsh chemicals. No dirt-attracting residue means dirt doesn't stick.
            </p>
            <p class="text-text/70">
              Your carpets stay cleaner longer—essential when Phoenix dust is constantly trying to invade your home.
            </p>
          </div>
        </div>

        <!-- Key Benefits Summary -->
        <div
          class="bg-dark text-white rounded-2xl p-8 md:p-12 text-center"
          data-aos="fade-up-sm"
        >
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            Why Phoenix Families Choose Our Method
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left md:text-center">
            <div>
              <div class="text-4xl mb-3">⚡</div>
              <div class="font-bold text-lg mb-2">Dries in 1-2 Hours</div>
              <div class="text-white/80 text-sm">Perfect for Phoenix's dry climate</div>
            </div>
            <div>
