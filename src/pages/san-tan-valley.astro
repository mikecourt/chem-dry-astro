    icon: "FaHome"
  },
  {
    name: "Encanterra",
    title: "Premium Service for Encanterra Golf Community",
    description: "Encanterra's beautiful golf community homes deserve specialized care. Our expert technicians understand the needs of this active adult community, including pool area carpet concerns and maintaining pristine home environments.",
