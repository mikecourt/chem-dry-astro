        {neighborhoods.map((neighborhood, index) => (
          <div
            class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 lg:p-10 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-border"
            data-aos="fade-up-sm"
            data-aos-delay={index * 100}
          >
            <div class="flex items-start gap-4 mb-6">
              <div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white text-3xl flex-shrink-0">
                {neighborhood.icon === "FaHome" && "🏘️"}
                {neighborhood.icon === "FaStar" && "⛳"}
                {neighborhood.icon === "FaCrown" && "🌳"}
                {neighborhood.icon === "FaMountain" && "🏔️"}
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold text-dark mb-2">
                  {neighborhood.name}
                </h3>
                <h4 class="text-lg md:text-xl font-semibold text-primary mb-3">
                  {neighborhood.title}
                </h4>
              </div>
            </div>

            <p class="text-base md:text-lg text-text/80 mb-6 leading-relaxed">
              {neighborhood.description}
            </p>

            <ul class="space-y-3">
              {neighborhood.highlights.map((highlight) => (
                <li class="flex items-start gap-3">
                  <span class="text-primary text-xl flex-shrink-0 mt-1">✓</span>
                  <span class="text-text/90">{highlight}</span>
