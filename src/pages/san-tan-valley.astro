            <span>Family Owned Since 1995</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary">✓</span>
            <span>All San Tan Valley Communities</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- San Tan Valley Neighborhoods Section - FEATURED -->
  <section class="section bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <p
          class="text-accent font-semibold text-sm md:text-base mb-3 tracking-wider uppercase"
          data-aos="fade-up-sm"
        >
          Local Expertise
        </p>
        <CustomHeading
          as="h2"
          text="San Tan Valley Communities We Serve"
          svgColor="text-accent"
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark mb-6"
          dataAos="fade-up-sm"
          dataAosDelay="50"
        />
        <p
          class="text-lg md:text-xl text-text/80 max-w-3xl mx-auto"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          We understand San Tan Valley's growing communities and the unique needs of newer homes and active families.
        </p>
      </div>

