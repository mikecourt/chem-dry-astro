      "Desert dust specialists",
      "Mountain area expertise",
      "Fast 1-2 hour dry time",
      "Flexible scheduling"
    ],
    icon: "FaMountain"
  }
];

// San Tan Valley services
const services = [
  {
    title: "Carpet Cleaning",
    description: "Hot Carbonating Extraction removes desert dust, allergens, and deep-set dirt from your San Tan Valley home's carpets.",
    icon: "FaHouseUser",
    link: "/services/carpet-cleaning"
  },
  {
    title: "Tile & Grout Cleaning",
    description: "Restore tile floors common in San Tan Valley homes. Remove years of pool area and desert dust buildup from grout lines.",
    icon: "FaTh",
    link: "/services/tile-and-grout-cleaning"
  },
  {
    title: "Upholstery Cleaning",
    description: "Refresh furniture that bears the brunt of family life and desert dust in San Tan Valley homes.",
    icon: "FaCouch",
    link: "/services/upholstery-cleaning"
  },
  {
    title: "Pet Odor Removal",
    description: "Eliminate pet odors and stains with our P.U.R.T.® treatment. Gentle on San Tan Valley's pet-loving families.",
    icon: "FaPaw",
    link: "/services"
  },
  {
    title: "Area Rug Cleaning",
    description: "Specialized cleaning for the rugs that define your San Tan Valley home's style.",
    icon: "FaRug",
    link: "/services"
  },
  {
    title: "Allergen Removal",
    description: "Critical in San Tan Valley's growing community. Remove dust, pollen, and allergens that accumulate year-round.",
    icon: "FaLeaf",
    link: "/services/carpet-cleaning"
  }
];

// San Tan Valley ZIP codes
const sanTanValleyZips = [
  { zip: "85140", area: "San Tan Valley" },
  { zip: "85142", area: "Queen Creek/San Tan Valley" },
  { zip: "85143", area: "San Tan Valley" },
  { zip: "85144", area: "Coolidge/San Tan Valley" },
];

// FAQ items
const faqs = [
  {
    question: "Do you serve Johnson Ranch?",
