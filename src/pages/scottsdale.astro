          </p>
        </div>

        <!-- Neighborhoods -->
        <div class="mb-12" data-aos="fade-up-sm" data-aos-delay="150">
          <h3 class="text-2xl font-semibold text-dark mb-6 text-center">Scottsdale Neighborhoods We Serve</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="bg-white p-4 rounded-lg shadow text-center">
              <p class="text-base font-semibold text-dark">North Scottsdale</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow text-center">
              <p class="text-base font-semibold text-dark">Old Town Scottsdale</p>
