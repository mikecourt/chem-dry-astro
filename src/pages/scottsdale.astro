            dataAosDelay="50"
          />
        </div>

        <!-- Service Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Carpet Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="text-4xl mb-4">🏠</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Carpet Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Our Hot Carbonating Extraction process uses about 80% less water than steam cleaning, dries in 1-2 hours, and is safe for all carpet types including luxury materials.
            </p>
            <a href="/services/carpet-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Area Rug Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Area Rug Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Expert care for Persian rugs, Oriental rugs, and luxury area rugs. We understand the delicate nature of fine rugs and treat each piece with specialized attention.
            </p>
            <a href="/services/area-rug-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Upholstery Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="text-4xl mb-4">🛋️</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Upholstery Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              The same gentle, effective process works beautifully on fine upholstery, sofas, chairs, and other furniture. Remove years of dust and allergens while protecting your investment.
            </p>
            <a href="/services/upholstery-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Specialty Stain Removal -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="250">
            <div class="text-4xl mb-4">✨</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Specialty Stain Removal</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              From wine spills to pet accidents, we have specialized treatments to remove tough stains without damaging your luxury carpets or area rugs.
            </p>
            <a href="/services/specialty-stain-removal" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Tile & Grout Cleaning -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="300">
            <div class="text-4xl mb-4">💎</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Tile & Grout Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Restore the beauty of your tile floors and eliminate bacteria hiding in grout lines. Our specialized cleaning and sealing process makes tile look like new.
            </p>
            <a href="/services/tile-and-grout-cleaning" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>

          <!-- Pet Urine Removal -->
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="350">
            <div class="text-4xl mb-4">🐾</div>
            <h3 class="text-xl font-semibold text-dark mb-3">Pet Urine Removal</h3>
            <p class="text-base leading-relaxed text-text/80 mb-4">
              Our P.U.R.T. treatment uses advanced chemistry to destroy urine crystals at their source, eliminating odors permanently—not just masking them.
            </p>
            <a href="/services/pet-urine-removal" class="text-primary font-semibold hover:underline">
              Learn More →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section: Scottsdale Reviews -->
