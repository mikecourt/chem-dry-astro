---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import CityTestimonials from "@/components/CityTestimonials.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const title = "Carpet Cleaning Scottsdale";
const meta_title = "Carpet Cleaning Scottsdale AZ | Premium White Glove Service | Brimley's";
const description = "Carpet cleaning Scottsdale AZ - premium white glove service for luxury homes. Hot Carbonating Extraction, safe for fine rugs. Free quote: (480) 649-3663";
const canonical = "https://whiteglovecarpet.com/scottsdale";
---

<Base title={title} description={description} meta_title={meta_title} canonical={canonical}>
  <SchemaMarkup type="city" city="Scottsdale" state="Arizona" postalCodes={["85250", "85251", "85252", "85253", "85254", "85255", "85256", "85257", "85258", "85259", "85260", "85261", "85262", "85263", "85264", "85266", "85267", "85268", "85269", "85271"]} />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.webp'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay (Radial gradient from left-center) -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
      >
        Premium Carpet Cleaning in Scottsdale
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Professional Carpet Cleaning<br class='hidden lg:block' /> in **Scottsdale**, Arizona"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        Trusted by Scottsdale homeowners since 1995. White Glove service for luxury homes in North Scottsdale, Old Town, DC Ranch, Grayhawk, McDowell Mountain Ranch, and Gainey Ranch.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="150">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🏆
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">White Glove Service</div>
            <div class="text-xs md:text-sm text-gray-600">Premium care for luxury homes</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ✨
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Expert Care</div>
            <div class="text-xs md:text-sm text-gray-600">Safe for high-end materials</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            💧
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">80% Less Water Used</div>
            <div class="text-xs md:text-sm text-gray-600">Carpets dry in 1-2 hours</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🌿
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Natural, Green-Certified</div>
            <div class="text-xs md:text-sm text-gray-600">Non-toxic cleaning safe for your family</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
        <CustomButton
          label="Get My Free Estimate"
          link="#contact-form"
          variant="primary"
          data_track="cta-click"
          data_track_location="hero-scottsdale"
          data_track_action="navigate-form"
        />
        <CustomButton
          label="(480) 649-3663"
          link="tel:4806493663"
          variant="secondary"
          icon="FaPhone"
          data_track="phone-click"
          data_track_location="hero-scottsdale"
        />
      </div>
    </div>
  </section>

  <!-- Problem Section: Scottsdale Homeowner Concerns -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Premium Homes Deserve Premium Care
          </p>
          <CustomHeading
            as="h2"
            text="Protecting Your **Scottsdale** Home Investment"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              Your Scottsdale home represents a significant investment, and your luxury carpets and area rugs deserve expert treatment. Whether you're in a custom estate in DC Ranch, a contemporary home in Grayhawk, or a classic residence in Old Town, you need a carpet cleaning service that understands the unique requirements of high-end homes.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              Traditional carpet cleaners use harsh chemicals and excessive water that can damage delicate fibers, leave sticky residue, and take days to dry. Your premium carpets deserve better.
            </p>
          </div>
        </div>

        <!-- Three Problem Areas -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Problem 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Risk of Damage</h3>
            <p class="text-base leading-relaxed text-text/80">
              High-end carpets and luxury area rugs require specialized care. Generic cleaning methods can damage delicate fibers, fade colors, or cause shrinkage in expensive materials.
            </p>
          </div>

          <!-- Problem 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Extended Dry Times</h3>
            <p class="text-base leading-relaxed text-text/80">
              Traditional steam cleaning saturates carpets with gallons of water, leaving them wet for 1-2 days. This disrupts your lifestyle and risks mold growth in Arizona's climate.
            </p>
          </div>

          <!-- Problem 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Harsh Chemicals</h3>
            <p class="text-base leading-relaxed text-text/80">
              Many carpet cleaners use strong detergents and chemical-laden solutions that leave residue, create overpowering odors, and aren't safe for your family or pets.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section: White Glove Service for Scottsdale -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Scottsdale Solution
          </p>
          <CustomHeading
            as="h2"
            text="White Glove Service for **Luxury** Homes"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              At Brimley's White Glove Chem-Dry, we've been serving discerning Scottsdale homeowners for over 25 years with a level of care that matches the quality of your home. Our Hot Carbonating Extraction process is gentle on luxury carpets, uses about 80% less water than steam cleaning, and delivers superior results without harsh chemicals.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              We understand that your home in North Scottsdale, DC Ranch, or Gainey Ranch demands meticulous attention to detail and professional service. That's exactly what we deliver.
            </p>
          </div>
        </div>

        <!-- Three Solution Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Solution 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Experience with Luxury Homes</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our IICRC-certified technicians have extensive experience working with high-end carpets, Persian rugs, and luxury materials. We understand how to treat wool, silk, and other premium fibers with the care they deserve.
            </p>
          </div>

          <!-- Solution 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Safe for High-End Materials</h3>
            <p class="text-base leading-relaxed text-text/80">
              The Natural®, our EPA-certified cleaning solution, is gentle enough for the finest carpets yet powerful enough to remove deep-seated dirt. No harsh chemicals, no dirt-attracting residue, no damage to delicate fibers.
            </p>
          </div>

          <!-- Solution 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Meticulous Attention to Detail</h3>
            <p class="text-base leading-relaxed text-text/80">
              From protective booties and corner guards to our thorough walk-through and post-cleaning inspection, we treat your Scottsdale home with the same respect we'd treat our own.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services in Scottsdale Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Premium Services
          </p>
          <CustomHeading
            as="h2"
            text="Complete Cleaning Solutions for **Scottsdale** Homes"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
