---
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import { sanityClient } from "@/lib/sanity";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { PortableText } from "astro-portabletext";
import { getEntry, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  // Slugs handled by dedicated .astro pages — exclude them from dynamic routing
  const staticServicePages = new Set([
    "carpet-cleaning",
    "upholstery-cleaning",
    "tile-and-grout-cleaning",
    "leather-cleaning",
    "stone-tile-cleaning-polishing",
    "granite-countertop-renewal",
    "dryer-vent-cleaning",
  ]);
  const redirectAliases = new Set(["tile-grout-cleaning"]);

  const services: { slug: string }[] = await sanityClient.fetch(
    `*[_type == "service" && !draft]{ "slug": slug.current }`
  );

  return services
    .filter(
      (s) => !staticServicePages.has(s.slug) && !redirectAliases.has(s.slug)
    )
    .map((s) => ({ params: { single: s.slug } }));
}

const { single } = Astro.params;
const service = await sanityClient.fetch(
  `*[_type == "service" && slug.current == $slug && !draft][0]{
    title,
    "slug": slug.current,
    meta_title,
    description,
    "banner": banner.asset->url,
    body
  }`,
  { slug: single }
);

const callToAction = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const canonical = `https://whiteglovecarpet.com/services/${single}`;
---

<Base
  title={service?.title}
  meta_title={service?.meta_title}
  description={service?.description}
  image={service?.banner}
  canonical={canonical}
>
  <SchemaMarkup type="service" serviceName={service?.title} />
  <section class="py-20 md:py-32 mt-24 sm:mt-20">
    <div class="container">
      <div class="mx-auto max-w-[60rem]">
        <p class="text-sm font-semibold tracking-wider uppercase text-accent mb-3">
          Professional Service
        </p>
        <h1 class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6">
          {service?.title}
        </h1>
        {
          service?.description && (
            <p
              class="text-lg text-text/80 mb-8"
              set:html={markdownify(service.description)}
            />
          )
        }
        <article class="content">
          {service?.body && <PortableText value={service.body} />}
        </article>
      </div>
    </div>
  </section>
  <CallToAction cta={callToAction.data} />
</Base>
