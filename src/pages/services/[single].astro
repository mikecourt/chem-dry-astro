---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import TrustBar from "@/components/TrustBar.astro";
import AllergenDisclaimer from "@/components/AllergenDisclaimer.astro";
import Base from "@/layouts/Base.astro";
import { sanityClient, urlFor } from "@/lib/sanity";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const services = await sanityClient.fetch<Array<{ slug: string }>>(
    `*[_type == "service" && !draft]{ "slug": slug.current }`
  );
  return services.map((s) => ({ params: { single: s.slug } }));
}

const { single } = Astro.params;

const service = await sanityClient.fetch(
  `*[_type == "service" && slug.current == $slug && !draft][0]{
    title,
    "slug": slug.current,
    meta_title,
    description,
    canonical,
    "heroImageUrl": heroImage.asset->url,
    heroEyebrow,
    heroHeading,
    heroSubheading,
    trustBadges,
    body,
    serviceTimeline,
    faqItems,
    pageTestimonials,
    relatedServices,
    "bannerUrl": banner.asset->url
  }`,
  { slug: single }
);

// Fetch CTA from Sanity (fallback to content collection if not migrated yet)
let ctaData: any;
try {
  ctaData = await sanityClient.fetch(`*[_type == "callToAction"][0]`);
} catch {
  const { getEntry } = await import("astro:content");
  const cta = await getEntry("ctaSection", "call-to-action");
  ctaData = cta?.data;
}

const hasRichLayout = !!(service?.heroImageUrl || service?.heroHeading);
const heroImage = service?.heroImageUrl || service?.bannerUrl || "";
const canonicalUrl = service?.canonical || `https://whiteglovecarpet.com/services/${single}`;
---

<Base
  title={service?.title}
  meta_title={service?.meta_title}
  description={service?.description}
  image={heroImage}
  canonical={canonicalUrl}
>
  <SchemaMarkup type="service" serviceName={service?.title} />

  {hasRichLayout ? (
    <!-- ═══ RICH SERVICE PAGE (hero + structured sections) ═══ -->

    <!-- Hero Section -->
    <section
      class="py-24 md:py-40 lg:py-48 relative mb-0"
      style={`background-image: url('${heroImage}'); background-size: cover; background-position: center center;`}
    >
      <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

      <div class="relative z-20 px-[30px]">
        {service.heroEyebrow && (
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left" data-aos="fade-up-sm">
            {service.heroEyebrow}
          </p>
        )}

        {service.heroHeading && (
          <CustomHeading
            as="h1"
            text={service.heroHeading}
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        )}

        {service.heroSubheading && (
          <h2 class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left" data-aos="fade-up-sm" data-aos-delay="100">
            {service.heroSubheading}
          </h2>
        )}

        {service.trustBadges?.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0" data-aos="fade-up-sm" data-aos-delay="150">
            {service.trustBadges.map((badge: any) => (
              <div class="flex items-center justify-center sm:justify-start gap-3">
                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
                  {badge.emoji}
                </div>
                <div class="text-center sm:text-left">
                  <div class="font-bold text-dark text-sm md:text-base">{badge.title}</div>
                  <div class="text-xs md:text-sm text-gray-600">{badge.subtitle}</div>
                </div>
              </div>
            ))}
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
          <CustomButton label="Get My Free Estimate" link="#contact-form" variant="primary" />
          <CustomButton label="(480) 649-3663" link="tel:4806493663" variant="secondary" icon="FaPhone" />
        </div>
      </div>
    </section>
  ) : (
    <!-- ═══ SIMPLE SERVICE PAGE (title + body) ═══ -->
    <section class="py-20 md:py-32 mt-24 sm:mt-20">
      <div class="container">
        <div class="mx-auto max-w-[60rem]">
          <p class="text-sm font-semibold tracking-wider uppercase text-accent mb-3">Professional Service</p>
          <h1 class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6">{service?.title}</h1>
          {service?.description && (
            <p class="text-lg text-text/80 mb-8" set:html={markdownify(service.description)} />
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Body Content (Portable Text) -->
  {service?.body && (
    <section class="section">
      <div class="container">
        <div class="mx-auto max-w-[65rem]">
          <article class="content prose prose-lg max-w-none">
            <PortableText value={service.body} />
          </article>
        </div>
      </div>
    </section>
  )}

  <!-- Service Timeline (Before / During / After) -->
  {service?.serviceTimeline?.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="mx-auto max-w-[65rem]">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
              What Makes Our Service "White Glove"?
            </p>
            <CustomHeading
              as="h2"
              text="The **Details** Matter"
              svgColor="text-primary"
              class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
              dataAos="fade-up-sm"
              dataAosDelay="50"
            />
          </div>

          <div class="space-y-8">
            {service.serviceTimeline.map((phase: any, index: number) => (
              <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay={100 + index * 50}>
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                    <span class="text-primary font-bold">{index + 1}</span>
                  </div>
                </div>
                <div>
                  <h4 class="text-xl font-semibold text-dark mb-3">{phase.title}</h4>
                  <ul class="space-y-2 text-base text-text/80">
                    {phase.items?.map((item: string) => (
                      <li class="flex gap-2">
                        <span class="text-primary">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {service?.pageTestimonials?.length > 0 && (
    <section class="section bg-light">
      <div class="container">
        <div class="mx-auto max-w-[65rem]">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">Testimonials</p>
            <CustomHeading
              as="h2"
              text={`Hear From Your **Neighbors**`}
              svgColor="text-primary"
              class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
              dataAos="fade-up-sm"
              dataAosDelay="50"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {service.pageTestimonials.map((t: any, i: number) => (
              <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay={100 + i * 50}>
                <div class="flex gap-1 mb-4">
                  {[...Array(t.rating || 5)].map(() => (
                    <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <p class="text-base leading-relaxed text-text/80 mb-4 italic">"{t.quote}"</p>
                <p class="text-sm font-semibold text-dark">{t.author}, {t.location}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  {service?.relatedServices?.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="mx-auto max-w-[65rem]">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">Complete Cleaning Solutions</p>
            <CustomHeading
              as="h2"
              text={`More Than Just **${service.title}**`}
              svgColor="text-primary"
              class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
              dataAos="fade-up-sm"
              dataAosDelay="50"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {service.relatedServices.map((rs: any, i: number) => (
              <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay={100 + i * 50}>
                <div class="text-4xl mb-4">{rs.emoji}</div>
                <h3 class="text-xl font-semibold text-dark mb-3">{rs.heading}</h3>
                <h4 class="text-lg font-semibold text-dark mb-2">{rs.serviceTitle}</h4>
                <p class="text-base leading-relaxed text-text/80 mb-4">{rs.description}</p>
                <a href={rs.link} class="text-primary font-semibold hover:underline">
                  Learn More →
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {service?.faqItems?.length > 0 && (
    <section class="section bg-light">
      <div class="container">
        <div class="mx-auto max-w-[65rem]">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">FAQ</p>
            <CustomHeading
              as="h2"
              text="Frequently Asked **Questions**"
              svgColor="text-primary"
              class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
              dataAos="fade-up-sm"
              dataAosDelay="50"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {service.faqItems.map((faq: any, i: number) => (
              <div class="bg-white p-8 rounded-xl shadow-lg border-2 border-gray-100 hover:border-primary/20 transition-all" data-aos="fade-up-sm" data-aos-delay={100 + i * 50}>
                <h3 class="text-xl font-bold text-dark mb-4">{faq.question}</h3>
                <p class="text-base leading-relaxed text-text/80">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="container max-w-[65rem] mx-auto px-4">
    <AllergenDisclaimer />
  </div>

  <TrustBar />

  {ctaData && <CallToAction cta={ctaData} />}
</Base>
