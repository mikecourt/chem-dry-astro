---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const allServices = await getSinglePage("services");
const relatedServices = allServices.filter(s =>
  ['carpet-cleaning', 'tile-and-grout-cleaning', 'upholstery-cleaning'].includes(s.id)
).slice(0, 3);

const title = "Dryer Vent Cleaning";
const meta_title = "Dryer Vent Cleaning Phoenix | Prevent Fires & Save Energy | Brimley's";
const description = "Professional dryer vent cleaning in Phoenix & Mesa. Prevent fires, reduce drying time, lower energy bills. Safety inspection included. 25+ years experience!";
---

<Base title={title} description={description} meta_title={meta_title}>
  <SchemaMarkup type="service" serviceName="Dryer Vent Cleaning" />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.jpg'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay (Radial gradient from left-center) -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
      >
        Dryer Vent Cleaning
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Prevent Dryer Fires & **Save** Energy<br class='hidden lg:block' /> with Professional Vent Cleaning"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        Protect your family from fire hazards while reducing drying time by up to 50% and lowering your energy bills.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="150">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🔥
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Prevent House Fires</div>
            <div class="text-xs md:text-sm text-gray-600">15,000+ dryer fires occur annually</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ⚡
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Reduce Energy Bills</div>
            <div class="text-xs md:text-sm text-gray-600">Cut drying time up to 50%</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🔍
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Professional Inspection</div>
            <div class="text-xs md:text-sm text-gray-600">Complete safety assessment included</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🏆
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">25+ Years Experience</div>
            <div class="text-xs md:text-sm text-gray-600">Trusted Phoenix Valley experts</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
        <CustomButton
          label="Schedule Safety Inspection"
          link="#contact-form"
          variant="primary"
        />
        <CustomButton
          label="(480) 649-3663"
          link="tel:+14806493663"
          variant="secondary"
          icon="FaPhone"
        />
      </div>
    </div>
  </section>

  <!-- The Hidden Danger Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-red-600 mb-3" data-aos="fade-up-sm">
            The Hidden Danger in Your Home
          </p>
          <CustomHeading
            as="h2"
            text="Lint Buildup is a **Fire Hazard** Hiding in Plain Sight"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              Every time you run your dryer, lint escapes the filter and builds up in your dryer vent system. Over months and years, this highly flammable material accumulates, restricting airflow and creating a serious fire hazard.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              According to the U.S. Fire Administration, dryers cause over 15,000 house fires every year, resulting in $35+ million in property damage. The leading cause? Failure to clean dryer vents.
            </p>
          </div>
        </div>

        <!-- Warning Signs Grid -->
        <div class="bg-red-50 border-2 border-red-200 rounded-lg p-8 mb-8" data-aos="fade-up-sm" data-aos-delay="150">
          <h3 class="text-2xl font-bold text-dark mb-6 text-center">Warning Signs Your Dryer Vent Needs Cleaning</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">Clothes Take Longer to Dry</p>
                <p class="text-sm text-text/80">What used to take one cycle now takes two or more</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">Dryer Gets Very Hot</p>
                <p class="text-sm text-text/80">The exterior of your dryer is hot to the touch</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">Burning Smell</p>
                <p class="text-sm text-text/80">You notice a burning odor when the dryer is running</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">Lint Around Dryer Door</p>
                <p class="text-sm text-text/80">Excessive lint accumulating around the door seal</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">Vent Hood Flap Doesn't Open</p>
                <p class="text-sm text-text/80">Outside vent flap remains closed while dryer runs</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-red-600 text-xl flex-shrink-0">⚠️</span>
              <div>
                <p class="font-semibold text-dark">It's Been Over a Year</p>
                <p class="text-sm text-text/80">You can't remember the last time it was cleaned</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="bg-white p-6 rounded-lg shadow-lg text-center">
            <div class="text-4xl font-bold text-red-600 mb-2">15,000+</div>
            <p class="text-sm text-text/80">Dryer fires per year in the U.S.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg text-center">
            <div class="text-4xl font-bold text-red-600 mb-2">$35M+</div>
            <p class="text-sm text-text/80">In property damage annually</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg text-center">
            <div class="text-4xl font-bold text-primary mb-2">100%</div>
            <p class="text-sm text-text/80">Preventable with regular cleaning</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Solution Section -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Solution
          </p>
          <CustomHeading
            as="h2"
            text="Professional Dryer Vent **Cleaning** & Safety Inspection"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Our comprehensive dryer vent cleaning service removes years of dangerous lint buildup from your entire vent system—from the dryer connection to the exterior vent hood. We don't just clean what you can see; we clean the entire length of your vent line where the real danger hides.
          </p>
        </div>

        <!-- Benefits Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Safety Benefits -->
          <div class="bg-light p-8 rounded-lg">
            <h3 class="text-2xl font-semibold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">🛡️</span>
              Safety Benefits
            </h3>
            <ul class="space-y-3 text-base text-text/80">
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Eliminate fire hazards</strong> by removing highly flammable lint</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Prevent carbon monoxide buildup</strong> in gas dryers</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Reduce risk of dryer overheating</strong> and malfunction</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Improve indoor air quality</strong> by ensuring proper ventilation</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Complete safety inspection</strong> of entire vent system</span>
              </li>
            </ul>
          </div>

          <!-- Performance & Savings Benefits -->
          <div class="bg-light p-8 rounded-lg">
            <h3 class="text-2xl font-semibold text-dark mb-6 flex items-center gap-3">
              <span class="text-3xl">💰</span>
              Performance & Savings
            </h3>
            <ul class="space-y-3 text-base text-text/80">
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Reduce drying time up to 50%</strong> with improved airflow</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Lower energy bills</strong> with more efficient operation</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Extend dryer lifespan</strong> by reducing strain on components</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Clothes dry faster and more thoroughly</strong></span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span><strong>Prevent premature dryer failure</strong> and costly repairs</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Process Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Our Process
          </p>
          <CustomHeading
            as="h2"
            text="Complete Vent System **Cleaning**"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            We use professional-grade equipment and proven techniques to thoroughly clean your entire dryer vent system, ensuring maximum safety and efficiency.
          </p>
        </div>

        <!-- Process Steps -->
        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="100">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">1</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Initial Inspection & Assessment</h4>
              <p class="text-base text-text/80 mb-2">
                We begin with a thorough inspection of your dryer vent system, checking the connection, vent line length, exterior hood, and overall condition. We identify any damage, improper installations, or safety concerns.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="150">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">2</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Disconnect & Access Points</h4>
              <p class="text-base text-text/80 mb-2">
                We carefully disconnect the dryer and access both the interior connection and exterior vent hood to ensure we can clean the entire length of the vent line.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="200">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">3</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Professional Rotary Brush Cleaning</h4>
              <p class="text-base text-text/80 mb-2">
                Using specialized rotary brush equipment, we thoroughly clean the entire length of your vent line, removing all lint, debris, and buildup from the walls of the ductwork. Our powerful vacuum system captures everything we remove.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="250">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">4</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Exterior Vent Hood Cleaning</h4>
              <p class="text-base text-text/80 mb-2">
                We clean the exterior vent hood, remove any bird nests or blockages, and ensure the flap operates properly to prevent pests from entering while allowing proper airflow.
              </p>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="300">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">5</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Reconnection & Airflow Test</h4>
              <p class="text-base text-text/80 mb-2">
                We properly reconnect your dryer with secure, code-compliant fittings and perform an airflow test to ensure optimal performance and safety.
              </p>
            </div>
          </div>

          <!-- Step 6 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="350">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">6</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Final Inspection & Education</h4>
              <p class="text-base text-text/80 mb-2">
                We walk you through our findings, show you the lint we removed, provide safety recommendations, and educate you on maintenance best practices to keep your dryer running safely and efficiently.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Brimley's Section -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Brimley's Difference
          </p>
          <CustomHeading
            as="h2"
            text="Why Choose Brimley's **White Glove** Service"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Three Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Pillar 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Safety-First Professionals</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our technicians are trained in dryer vent safety standards and use professional-grade equipment to ensure your home is protected from fire hazards.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Complete System Cleaning</h3>
            <p class="text-base leading-relaxed text-text/80">
              We clean the entire vent system from dryer to exterior—not just what's easily accessible. Our thorough approach ensures maximum safety and efficiency.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">25+ Years of Trust</h3>
            <p class="text-base leading-relaxed text-text/80">
              Since 1995, Phoenix Valley families have trusted us to protect their homes. Our "white glove" service means we treat your home with the utmost care and respect.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Testimonials
          </p>
          <CustomHeading
            as="h2"
            text="Hear From Your **Neighbors** in Phoenix & Mesa"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="flex gap-1 mb-4">
