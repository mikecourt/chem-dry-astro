---
import Process from "@/layouts/components/services/Process.astro";
import ServicesIndex from "@/layouts/components/services/ServicesIndex.astro";
import Base from "@/layouts/Base.astro";
import { sanityClient } from "@/lib/sanity";
import CallToAction from "@/partials/CallToAction.astro";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Fetch the services index metadata from Sanity (the singleton "servicesIndex" doc if it exists,
// otherwise fall back to a hardcoded default that matches the old -index.md content)
const serviceIndexDoc = await sanityClient.fetch(
  `*[_type == "servicesIndex"][0]{ title, subtitle, description, meta_title }`
).catch(() => null);

const serviceIndex = serviceIndexDoc ?? {
  title: "**Professional** Carpet & Upholstery Cleaning Services in Phoenix",
  subtitle: "OUR SERVICES",
  meta_title: "Carpet Cleaning Services Phoenix | Brimley's White Glove Chem-Dry",
  description:
    "Professional carpet, upholstery, tile, and area rug cleaning services in Phoenix. Hot Carbonating Extraction dries in 1-2 hours. Family-owned since 1995.",
};

const allServices = await sanityClient.fetch(
  `*[_type == "service" && !draft] | order(weight asc) {
    title,
    "slug": slug.current,
    categories
  }`
);

const callToAction = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;
---

<Base title={serviceIndex.title} meta_title={serviceIndex.meta_title} description={serviceIndex.description}>
  <ServicesIndex serviceIndex={serviceIndex} allServices={allServices} />
  <Process process={undefined} />

  <CallToAction cta={callToAction.data} />
</Base>
