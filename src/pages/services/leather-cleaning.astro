---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const title = "Leather Cleaning & Conditioning";
const meta_title = "Leather Furniture Cleaning & Conditioning Phoenix | Brimley's";
const description = "Professional leather cleaning & conditioning in Phoenix & Mesa. Restore moisture, prevent cracking, extend furniture life. 30+ years experience. Free quote!";
---

<Base title={title} description={description} meta_title={meta_title}>
  <SchemaMarkup type="service" serviceName="Leather Cleaning" />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.webp'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay (Radial gradient from left-center) -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
      >
        Leather Cleaning & Conditioning
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Restore & **Protect** Your<br class='hidden lg:block' /> Leather Investment"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        Professional cleaning and conditioning that restores moisture, prevents cracking, and extends the life of your leather furniture.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="150">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🛡️
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Safe for All Leather Types</div>
            <div class="text-xs md:text-sm text-gray-600">From aniline to protected, bonded & more</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ✨
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Prevents Cracking & Fading</div>
            <div class="text-xs md:text-sm text-gray-600">Restores moisture and flexibility</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🧴
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">pH-Balanced Products</div>
            <div class="text-xs md:text-sm text-gray-600">Gentle formulas that won't damage finish</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🏆
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">30+ Years Experience</div>
            <div class="text-xs md:text-sm text-gray-600">Expert care for your finest furniture</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
        <CustomButton
          label="Get My Free Estimate"
          link="#contact-form"
          variant="primary"
        />
        <CustomButton
          label="(480) 649-3663"
          link="tel:4806493663"
          variant="secondary"
          icon="FaPhone"
        />
      </div>
    </div>
  </section>

  <!-- White Glove Promise Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The "White Glove" Promise
          </p>
          <CustomHeading
            as="h2"
            text="Trusted Care for Your **Finest** Furniture"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              Your leather furniture represents a significant investment in quality and style. Whether it's a cherished family heirloom or a stunning new piece, it deserves the highest level of care. That's why we treat every leather piece with the same meticulous attention we'd give our own finest furniture.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              Since 1995, we've been restoring and protecting Phoenix Valley leather furniture with specialized cleaning and conditioning treatments that preserve beauty and extend life for decades to come.
            </p>
          </div>
        </div>

        <!-- Three Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Pillar 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Leather Expertise</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our technicians are trained in identifying and caring for all leather types—from delicate aniline to durable protected leather. We use the right products and techniques for your specific leather.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Safe, Gentle Products</h3>
            <p class="text-base leading-relaxed text-text/80">
              We use pH-balanced, leather-safe cleaning solutions that remove dirt and body oils without stripping away natural oils or damaging the leather's protective finish.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Long-Term Protection</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our conditioning treatment restores essential moisture, maintains flexibility, and creates a protective barrier against future wear, UV damage, and premature aging.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem Section -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Problem
          </p>
          <CustomHeading
            as="h2"
            text="Why Leather **Needs** Professional Care"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <h3 class="text-2xl font-semibold text-dark mb-4" data-aos="fade-up-sm" data-aos-delay="100">
            Leather is a Natural Material That Dries Out Over Time
          </h3>
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="150">
            Unlike synthetic fabrics, leather is a living material that requires regular care to maintain its beauty and integrity. Without proper maintenance, leather gradually loses its essential oils, leading to serious problems:
          </p>
        </div>

        <!-- Problem Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="bg-red-50 p-6 rounded-lg border-2 border-red-100">
            <div class="flex gap-3 mb-3">
              <span class="text-red-500 text-2xl flex-shrink-0">⚠️</span>
              <h4 class="text-lg font-semibold text-dark">Cracking & Peeling</h4>
            </div>
            <p class="text-base text-text/80 ml-11">
              As leather dries out, it loses flexibility and begins to crack. Small cracks grow larger over time, eventually causing the leather to peel and become irreparable.
            </p>
          </div>

          <div class="bg-red-50 p-6 rounded-lg border-2 border-red-100">
            <div class="flex gap-3 mb-3">
              <span class="text-red-500 text-2xl flex-shrink-0">⚠️</span>
              <h4 class="text-lg font-semibold text-dark">Fading & Discoloration</h4>
            </div>
            <p class="text-base text-text/80 ml-11">
              UV exposure and accumulated dirt cause leather to fade unevenly, losing its rich color and developing an aged, worn appearance.
            </p>
          </div>

          <div class="bg-red-50 p-6 rounded-lg border-2 border-red-100">
            <div class="flex gap-3 mb-3">
              <span class="text-red-500 text-2xl flex-shrink-0">⚠️</span>
              <h4 class="text-lg font-semibold text-dark">Body Oils & Dirt Buildup</h4>
            </div>
            <p class="text-base text-text/80 ml-11">
              Skin oils, sweat, and everyday dirt penetrate the leather's surface, creating dark spots, stains, and an unpleasant sticky or greasy feeling.
            </p>
          </div>

          <div class="bg-red-50 p-6 rounded-lg border-2 border-red-100">
            <div class="flex gap-3 mb-3">
              <span class="text-red-500 text-2xl flex-shrink-0">⚠️</span>
              <h4 class="text-lg font-semibold text-dark">Premature Aging</h4>
            </div>
            <p class="text-base text-text/80 ml-11">
              Without proper conditioning, leather ages much faster than it should, dramatically shortening the lifespan of expensive furniture.
            </p>
          </div>
        </div>

        <div class="bg-light p-8 rounded-lg text-center" data-aos="fade-up-sm" data-aos-delay="250">
          <p class="text-lg leading-relaxed text-text/80 mb-4">
            <strong>The good news?</strong> Regular professional cleaning and conditioning can prevent all of these problems and keep your leather looking beautiful for decades.
          </p>
          <p class="text-base leading-relaxed text-text/80">
            Just like your skin needs moisturizer, leather needs conditioning to stay soft, supple, and protected from the elements.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Solution Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Our Solution
          </p>
          <CustomHeading
            as="h2"
            text="Professional Leather Cleaning & **Conditioning** Process"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Process Steps -->
        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="100">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">1</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Leather Type Assessment</h4>
              <p class="text-base text-text/80">
                We begin by identifying your specific leather type (aniline, semi-aniline, protected, bonded, or specialty) and assessing its condition. This ensures we use the appropriate products and techniques for optimal results without risk of damage.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="150">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">2</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Gentle Deep Cleaning</h4>
              <p class="text-base text-text/80">
                Using pH-balanced, leather-safe cleaners, we remove accumulated dirt, body oils, grime, and surface stains. Our gentle cleaning process lifts away contaminants without stripping the leather's natural protective oils or damaging the finish.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="200">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">3</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Moisture Restoration</h4>
              <p class="text-base text-text/80">
                We apply premium leather conditioners that penetrate deep into the leather, restoring essential moisture and oils. This treatment brings back flexibility, softness, and that luxurious leather feel.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="250">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">4</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Protection & UV Defense</h4>
              <p class="text-base text-text/80">
                Our conditioning treatment creates a protective barrier that guards against future dirt, stains, and UV damage. This helps prevent cracking, fading, and premature aging, extending the life of your leather furniture by years.
              </p>
            </div>
          </div>
        </div>

        <!-- Results Box -->
        <div class="bg-primary/5 p-8 rounded-lg border-2 border-primary/20 mt-12" data-aos="fade-up-sm" data-aos-delay="300">
          <h4 class="text-xl font-semibold text-dark mb-4 text-center">What You'll Notice After Treatment</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Restored color depth and richness</span>
            </div>
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Soft, supple texture that feels luxurious</span>
            </div>
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Clean, fresh appearance without residue</span>
            </div>
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Protection against future wear and damage</span>
            </div>
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Enhanced resistance to cracking and fading</span>
            </div>
            <div class="flex gap-2">
              <span class="text-primary flex-shrink-0">✓</span>
              <span class="text-base text-text/80">Extended furniture lifespan</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes Us Different Section -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Our Differentiator
          </p>
          <CustomHeading
            as="h2"
            text="Experience with **All** Leather Types"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Not all leather is the same, and a one-size-fits-all approach can cause serious damage. Our technicians are trained to identify and properly care for every type of leather furniture:
          </p>
        </div>

        <!-- Leather Types Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="100">
            <h4 class="text-lg font-semibold text-dark mb-3">Aniline Leather</h4>
            <p class="text-base leading-relaxed text-text/80">
              The most natural, luxurious leather with no protective coating. Requires gentle, specialized care to preserve its soft feel and natural appearance.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="150">
            <h4 class="text-lg font-semibold text-dark mb-3">Semi-Aniline Leather</h4>
            <p class="text-base leading-relaxed text-text/80">
              Features a light protective topcoat while maintaining natural softness. Benefits from regular conditioning to prevent drying and cracking.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="200">
            <h4 class="text-lg font-semibold text-dark mb-3">Protected (Pigmented) Leather</h4>
            <p class="text-base leading-relaxed text-text/80">
              Most common furniture leather with a durable finish coating. Highly stain-resistant but still needs conditioning to prevent surface cracking.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="250">
            <h4 class="text-lg font-semibold text-dark mb-3">Bonded Leather</h4>
            <p class="text-base leading-relaxed text-text/80">
              Made from leather scraps bonded to a backing. More delicate than genuine leather and requires specific cleaning techniques to avoid peeling.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="300">
            <h4 class="text-lg font-semibold text-dark mb-3">Nubuck & Suede</h4>
            <p class="text-base leading-relaxed text-text/80">
              Delicate, napped leather surfaces that require specialized dry-cleaning methods. We use appropriate techniques to clean without damaging texture.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="350">
            <h4 class="text-lg font-semibold text-dark mb-3">Exotic & Specialty Leathers</h4>
            <p class="text-base leading-relaxed text-text/80">
              From distressed leather to metallic finishes, we have experience with unique leather treatments and know how to care for specialty pieces.
            </p>
          </div>
        </div>

        <div class="bg-light p-8 rounded-lg mt-12 text-center" data-aos="fade-up-sm" data-aos-delay="400">
          <p class="text-lg leading-relaxed text-text/80">
            <strong>Not sure what type of leather you have?</strong> No problem. Our technicians will identify your leather type during our initial inspection and recommend the best care approach for your specific furniture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Testimonials
          </p>
          <CustomHeading
            as="h2"
            text="Hear From Your **Neighbors** in Phoenix & Mesa"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-lg" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="flex gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
