---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const allServices = await getSinglePage("services");
const relatedServices = allServices.filter(s =>
  ['carpet-cleaning', 'upholstery-cleaning', 'specialty-stain-removal'].includes(s.id)
).slice(0, 3);

const title = "Red Wine Stain Removal";
const meta_title = "Red Wine Stain Removal Phoenix | Emergency Carpet Stain Service";
const description = "Emergency red wine stain removal in Phoenix & Mesa. Specialized chemistry for wine stains on carpets & upholstery. Fast response. 25+ years experience!";
---

<Base title={title} description={description} meta_title={meta_title}>
  <SchemaMarkup type="service" serviceName="Red Wine Stain Removal" />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.jpg'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay (Radial gradient from left-center) -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Emergency Badge -->
      <div class="inline-flex items-center gap-2 bg-red-600 text-white px-4 py-2 rounded-full mb-4 text-center lg:text-left mx-auto lg:mx-0" data-aos="fade-up-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-bold text-sm uppercase tracking-wider">Emergency Service Available</span>
      </div>

      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="50"
      >
        Red Wine Stain Removal
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Emergency **Red Wine** Stain Removal<br class='hidden lg:block' /> in Phoenix & Mesa"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="100"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="150"
      >
        Time is critical. Our specialized wine stain chemistry works on fresh and old stains.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="200">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-600 text-white font-bold text-xl flex-shrink-0">
            ⚡
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Fast Emergency Response</div>
            <div class="text-xs md:text-sm text-gray-600">Call immediately for best results</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-600 text-white font-bold text-xl flex-shrink-0">
            🍷
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Wine-Specific Chemistry</div>
            <div class="text-xs md:text-sm text-gray-600">Specialized treatment for wine stains</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-600 text-white font-bold text-xl flex-shrink-0">
            ✓
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Works on All Surfaces</div>
            <div class="text-xs md:text-sm text-gray-600">Carpets, upholstery, and rugs</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-600 text-white font-bold text-xl flex-shrink-0">
            🏆
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">25+ Years Experience</div>
            <div class="text-xs md:text-sm text-gray-600">Phoenix Valley's trusted stain experts</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="250">
        <CustomButton
          label="Call Now - Time is Critical!"
          link="tel:+14806493663"
          variant="primary"
          icon="FaPhone"
        />
        <CustomButton
          label="Get Emergency Quote"
          link="#contact-form"
          variant="secondary"
        />
      </div>
    </div>
  </section>

  <!-- The Problem: Why Red Wine Stains Are So Feared -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-red-600 mb-3" data-aos="fade-up-sm">
            The Problem
          </p>
          <CustomHeading
            as="h2"
            text="Why Red Wine Stains Are One of the **Most Feared** Carpet Stains"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              Red wine is one of the most challenging stains because it acts quickly. The tannins and chromogens in red wine bond to carpet fibers almost immediately, and the longer they sit, the deeper they set into the carpet backing.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              To make matters worse, common DIY methods—salt, club soda, white wine—often make the problem worse by spreading the stain or setting it deeper into the fibers. What starts as a fixable spill can become a permanent reminder of one bad moment.
            </p>
          </div>
        </div>

        <!-- The Dangers of DIY -->
        <div class="bg-red-50 border-2 border-red-200 p-8 rounded-lg" data-aos="fade-up-sm" data-aos-delay="150">
          <h3 class="text-2xl font-bold text-dark mb-4 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Warning: DIY Methods Can Make It Worse
          </h3>
          <ul class="space-y-3 text-base text-text/80">
            <li class="flex gap-2">
              <span class="text-red-600 flex-shrink-0">✗</span>
              <span><strong>Salt:</strong> Can set the stain permanently by drawing wine deeper into carpet backing</span>
            </li>
            <li class="flex gap-2">
              <span class="text-red-600 flex-shrink-0">✗</span>
              <span><strong>Club Soda:</strong> Spreads the stain and dilutes it without actually removing the tannins</span>
            </li>
            <li class="flex gap-2">
              <span class="text-red-600 flex-shrink-0">✗</span>
              <span><strong>White Wine:</strong> Adds more liquid and acidity, making stain removal more difficult</span>
            </li>
            <li class="flex gap-2">
              <span class="text-red-600 flex-shrink-0">✗</span>
              <span><strong>Dish Soap:</strong> Leaves sticky residue that attracts more dirt and can damage fibers</span>
            </li>
            <li class="flex gap-2">
              <span class="text-red-600 flex-shrink-0">✗</span>
              <span><strong>Scrubbing:</strong> Damages carpet fibers and drives the stain deeper into the backing</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The Solution: Our Specialized Wine Stain Removal Process -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Our Solution
          </p>
          <CustomHeading
            as="h2"
            text="Specialized Wine Stain **Chemistry** That Works"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Unlike DIY methods that spread or set wine stains, we use professional-grade chemistry specifically designed to break down the tannins and chromogens in red wine. Our process doesn't just mask the stain—it removes it at the molecular level.
          </p>
        </div>

        <!-- Process Steps -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Step 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl font-bold text-primary">1</span>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Assessment & Pre-Treatment</h3>
            <p class="text-base leading-relaxed text-text/80">
              We assess the stain's age, depth, and carpet type, then apply our specialized wine stain pre-treatment that begins breaking down tannins immediately.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl font-bold text-primary">2</span>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Targeted Stain Removal</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our wine-specific chemistry penetrates deep into carpet fibers, neutralizing chromogens and lifting the stain from the backing up to the surface.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl font-bold text-primary">3</span>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-3">Hot Carbonating Extraction</h3>
            <p class="text-base leading-relaxed text-text/80">
              We use our powerful Hot Carbonating Extraction system to flush away dissolved tannins and wine residue, leaving carpets clean and dry in 1-2 hours.
            </p>
          </div>
        </div>

        <!-- What Makes Our Process Different -->
        <div class="bg-primary/5 p-8 rounded-lg border-2 border-primary/20" data-aos="fade-up-sm" data-aos-delay="200">
          <h3 class="text-2xl font-bold text-dark mb-6 text-center">What Makes Our Wine Stain Removal Different?</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">Wine-Specific Chemistry</p>
                <p class="text-sm text-text/80">Not generic cleaners—formulas designed for wine tannins</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">Works on Fresh & Old Stains</p>
                <p class="text-sm text-text/80">Better results when fresh, but effective on set-in stains</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">Safe for All Carpet Types</p>
                <p class="text-sm text-text/80">Color-safe, fiber-safe, effective on wool, nylon, polyester</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">No Sticky Residue</p>
                <p class="text-sm text-text/80">Stains won't reappear after treatment</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">Fast Drying Time</p>
                <p class="text-sm text-text/80">Back to normal in 1-2 hours, not days</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary flex-shrink-0 text-xl">✓</span>
              <div>
                <p class="font-semibold text-dark">Works on Multiple Surfaces</p>
                <p class="text-sm text-text/80">Carpets, upholstery, area rugs, and more</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Emergency Service & Time Sensitivity -->
  <section class="section bg-red-50">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <div class="text-center mb-8">
          <div class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-3 rounded-full mb-4" data-aos="fade-up-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-bold text-lg uppercase tracking-wider">Time is Critical</span>
          </div>
          <CustomHeading
            as="h2"
            text="Why **Immediate** Action Matters"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Fresh Spills -->
          <div class="bg-white p-8 rounded-lg shadow-lg" data-aos="fade-right-sm" data-aos-delay="100">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-green-500 text-white flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-dark">Fresh Spills (0-24 Hours)</h3>
            </div>
            <ul class="space-y-3 text-base text-text/80">
              <li class="flex gap-2">
                <span class="text-green-500 flex-shrink-0">•</span>
                <span>Wine hasn't fully bonded to carpet fibers yet</span>
              </li>
              <li class="flex gap-2">
                <span class="text-green-500 flex-shrink-0">•</span>
                <span>Tannins can be neutralized and removed completely</span>
              </li>
              <li class="flex gap-2">
                <span class="text-green-500 flex-shrink-0">•</span>
                <span>Higher success rate for complete stain removal</span>
              </li>
              <li class="flex gap-2">
                <span class="text-green-500 flex-shrink-0">•</span>
                <span>Less aggressive treatment needed</span>
              </li>
              <li class="flex gap-2">
                <span class="text-green-500 flex-shrink-0">•</span>
                <span><strong>Call immediately for best results</strong></span>
              </li>
            </ul>
          </div>

          <!-- Set-In Stains -->
          <div class="bg-white p-8 rounded-lg shadow-lg" data-aos="fade-left-sm" data-aos-delay="150">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-orange-500 text-white flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-dark">Set-In Stains (24+ Hours)</h3>
            </div>
            <ul class="space-y-3 text-base text-text/80">
              <li class="flex gap-2">
                <span class="text-orange-500 flex-shrink-0">•</span>
                <span>Tannins have bonded to carpet fibers</span>
              </li>
              <li class="flex gap-2">
                <span class="text-orange-500 flex-shrink-0">•</span>
                <span>Wine may have soaked into carpet backing</span>
              </li>
              <li class="flex gap-2">
                <span class="text-orange-500 flex-shrink-0">•</span>
                <span>More intensive treatment required</span>
              </li>
              <li class="flex gap-2">
                <span class="text-orange-500 flex-shrink-0">•</span>
                <span>May require multiple applications</span>
              </li>
              <li class="flex gap-2">
                <span class="text-orange-500 flex-shrink-0">•</span>
                <span><strong>Still treatable—don't give up!</strong></span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Emergency CTA -->
        <div class="text-center mt-12" data-aos="fade-up-sm" data-aos-delay="200">
          <p class="text-xl font-semibold text-dark mb-6">
            Just spilled wine? Call us NOW for emergency service.
          </p>
          <CustomButton
            label="Call (480) 649-3663 - Emergency Service"
            link="tel:+14806493663"
            variant="primary"
            icon="FaPhone"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Also Effective on Other Food Dye Stains -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Bonus
          </p>
          <CustomHeading
            as="h2"
            text="Also Works on **Other** Difficult Stains"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            Our specialized stain removal chemistry isn't just for wine. The same professional-grade treatment works on other tough food dye and beverage stains.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6" data-aos="fade-up-sm" data-aos-delay="150">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🍇</span>
            </div>
            <p class="font-semibold text-dark">Grape Juice</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🍒</span>
            </div>
            <p class="font-semibold text-dark">Berry Stains</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">☕</span>
            </div>
            <p class="font-semibold text-dark">Coffee & Tea</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🥤</span>
            </div>
            <p class="font-semibold text-dark">Soda & Juice</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🍫</span>
            </div>
            <p class="font-semibold text-dark">Chocolate</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🍅</span>
            </div>
            <p class="font-semibold text-dark">Tomato Sauce</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🍭</span>
            </div>
            <p class="font-semibold text-dark">Candy Dyes</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
              <span class="text-3xl">🎨</span>
            </div>
            <p class="font-semibold text-dark">Food Coloring</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            Testimonials
          </p>
          <CustomHeading
            as="h2"
            text="Phoenix Homeowners Trust Us with Their **Toughest Stains**"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

