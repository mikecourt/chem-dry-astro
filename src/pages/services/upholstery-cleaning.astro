---
import CustomButton from "@/components/CustomButton.astro";
import CustomHeading from "@/components/CustomHeading.astro";
import ImageMod from "@/components/ImageMod.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import TrustBar from "@/components/TrustBar.astro";
import AllergenDisclaimer from "@/components/AllergenDisclaimer.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const call_to_action = (await getEntry(
  "ctaSection",
  "call-to-action"
)) as CollectionEntry<"ctaSection">;

const allServices = await getSinglePage("services");
const relatedServices = allServices.filter(s =>
  ['carpet-cleaning', 'pet-urine-removal', 'leather-cleaning'].includes(s.id)
).slice(0, 3);

const title = "Upholstery Cleaning";
const meta_title = "Professional Upholstery Cleaning in Denver Metro | All Pro";
const description = "Expert upholstery cleaning in Denver Metro. Hot Carbonating Extraction is safe for all fabrics, dries in 1-2 hours. 30+ years experience. Free quote!";
---

<Base title={title} description={description} meta_title={meta_title}>
  <SchemaMarkup type="service" serviceName="Upholstery Cleaning" />

  <!-- Hero Section -->
  <section
    class="py-24 md:py-40 lg:py-48 relative mb-0"
    style="background-image: url('/images/carpet-cleaning-service-hero.webp'); background-size: cover; background-position: center center;">

    <!-- White Gradient Overlay (Radial gradient from left-center) -->
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 25% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 50%, transparent 85%);"></div>

    <!-- Content Container -->
    <div class="relative z-20 px-[30px]">
      <!-- Eyebrow -->
      <p
        class="text-sm font-semibold tracking-wider uppercase text-primary mb-3 text-center lg:text-left"
        data-aos="fade-up-sm"
      >
        Upholstery Cleaning
      </p>

      <!-- H1 -->
      <CustomHeading
        as="h1"
        text="Gentle, **Effective** Upholstery<br class='hidden lg:block' /> Cleaning for Denver Metro"
        svgColor="text-primary"
        class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6 text-center lg:text-left mx-auto lg:mx-0"
        dataAos="fade-up-sm"
        dataAosDelay="50"
      />

      <!-- H2 Subheading -->
      <h2
        class="text-lg md:text-xl text-text/80 mb-8 text-center lg:text-left"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        Our Hot Carbonating Extraction process is gentle on all fabric types, dries in 1-2 hours — no harsh chemicals, soaps, or fragrances.
      </h2>

      <!-- Trust Badges -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-2 sm:gap-y-3 mb-8 max-w-xl mx-auto lg:mx-0"
        data-aos="fade-up-sm"
        data-aos-delay="150">
        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🛋️
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Safe for All Fabrics</div>
            <div class="text-xs md:text-sm text-gray-600">Microfiber, linen, cotton, polyester & more</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ⏱️
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Dries in 1-2 Hours</div>
            <div class="text-xs md:text-sm text-gray-600">Use your furniture the same day</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            ✨
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Removes Body Oils & Allergens</div>
            <div class="text-xs md:text-sm text-gray-600">Healthier furniture, fresher home</div>
          </div>
        </div>

        <div class="flex items-center justify-center sm:justify-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-xl flex-shrink-0">
            🌿
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-dark text-sm md:text-base">Gentle Cleaning Process</div>
            <div class="text-xs md:text-sm text-gray-600">No harsh chemicals or soaps</div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" data-aos="fade-up-sm" data-aos-delay="200">
        <CustomButton
          label="Get My Free Estimate"
          link="#contact-form"
          variant="primary"
        />
        <CustomButton
          label="(303) 252-0517"
          link="tel:3032520517"
          variant="secondary"
          icon="FaPhone"
        />
      </div>
    </div>
  </section>

  <!-- White Glove Promise Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The "White Glove" Promise
          </p>
          <CustomHeading
            as="h2"
            text="Your Furniture Deserves **White Glove** Care"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <div class="space-y-4 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
            <p class="text-base leading-relaxed text-text/80">
              Your furniture is more than just a place to sit—it's where your family gathers, where memories are made, and where you relax at the end of the day. That's why we treat every piece with the same care and respect we'd give our own.
            </p>
            <p class="text-base leading-relaxed text-text/80">
              Since 1995, we've been helping Denver metro families extend the life of their furniture investments with gentle, effective cleaning that removes years of body oils, allergens, and dirt—without damage or harsh chemicals.
            </p>
          </div>
        </div>

        <!-- Three Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-aos="fade-up-sm" data-aos-delay="150">
          <!-- Pillar 1 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Fabric-Specific Expertise</h3>
            <p class="text-base leading-relaxed text-text/80">
              Our IICRC-certified technicians are trained to identify fabric types and adjust our cleaning process accordingly. From delicate microfiber to durable cotton, we know how to clean it safely.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">We Protect Your Investment</h3>
            <p class="text-base leading-relaxed text-text/80">
              We use protective floor coverings, gentle handling techniques, and specialized equipment to ensure your furniture is treated with the utmost care from start to finish.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-dark mb-2">Transparent Pricing</h3>
            <p class="text-base leading-relaxed text-text/80">
              You'll receive a clear, detailed estimate before any work begins. No hidden fees, no pressure tactics—just honest pricing for quality service.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chem-Dry Process Section -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            The Chem-Dry Process
          </p>
          <CustomHeading
            as="h2"
            text="Why Our Upholstery Clean is **Different**"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
          <h3 class="text-2xl font-semibold text-dark mb-4" data-aos="fade-up-sm" data-aos-delay="100">
            The Problem with Traditional Upholstery Cleaning (And Why We Use Carbonation)
          </h3>
          <p class="text-base leading-relaxed text-text/80 max-w-[55rem] mx-auto" data-aos="fade-up-sm" data-aos-delay="150">
            Traditional upholstery cleaning methods soak your furniture with gallons of water and harsh detergents, leaving cushions saturated for days and risking fabric damage. We use Hot Carbonating Extraction—the same gentle carbonation you find in sparkling water—to lift dirt and oils from deep within fabric fibers without over-wetting or damaging your furniture.
          </p>
        </div>

        <!-- Comparison Table -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" data-aos="fade-up-sm" data-aos-delay="200">
          <!-- Traditional Cleaning -->
          <div class="bg-gray-50 p-6 rounded-lg border-2 border-gray-200">
            <h4 class="text-lg font-semibold text-dark mb-4">Traditional Upholstery Cleaning (The "Old" Way)</h4>
            <ul class="space-y-3 text-sm text-text/80">
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Soaks furniture with excessive water</span>
              </li>
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Takes 24-48 hours to dry (furniture unusable)</span>
              </li>
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Uses harsh soaps and chemical detergents</span>
              </li>
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Leaves sticky residue that attracts dirt faster</span>
              </li>
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Can cause fabric shrinkage or discoloration</span>
              </li>
              <li class="flex gap-2">
                <span class="text-red-500 flex-shrink-0">✗</span>
                <span>Strong chemical smell lingers for days</span>
              </li>
            </ul>
          </div>

          <!-- Chem-Dry HCE -->
          <div class="bg-primary/5 p-6 rounded-lg border-2 border-primary/20">
            <h4 class="text-lg font-semibold text-dark mb-4">Chem-Dry HCE (Our "White Glove" Way)</h4>
            <ul class="space-y-3 text-sm text-text/80">
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>Uses about 80% less water than traditional methods</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>Dries in just 1-2 hours—use your furniture the same day</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>Uses millions of carbonating bubbles to lift dirt naturally</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>Leaves no dirt-attracting residue—fabrics stay cleaner longer</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>No harsh chemicals—gentle on all fabrics</span>
              </li>
              <li class="flex gap-2">
                <span class="text-primary flex-shrink-0">✓</span>
                <span>Fresh, clean scent—no overpowering odors</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Process Explanation -->
        <div class="bg-light p-8 rounded-lg" data-aos="fade-up-sm" data-aos-delay="250">
          <p class="text-base leading-relaxed text-text/80 mb-6">
            The process used by Chem-Dry doesn't rely on harsh soaps or detergents. Instead, The Natural® uses the power of carbonation to penetrate deep into upholstery fibers, explode dirt, body oils, and allergens to the surface, and extract them away—leaving your furniture truly clean without over-wetting or damaging delicate fabrics.
          </p>

          <!-- Diagram -->
          <div class="bg-white p-8 rounded-lg border-2 border-gray-200">
            <img
              src="/images/powerhead-graphic.webp"
              alt="Diagram showing carbonation bubbles lifting dirt particles from upholstery fibers"
              class="w-full h-auto rounded"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A Healthier Home Starts Here Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-[75rem]">
        <!-- Two Column Layout: Text Left, Image Right on Desktop -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- Left Column: Content -->
          <div class="order-2 lg:order-1">
            <!-- Eyebrow -->
            <p class="text-sm font-semibold tracking-wider uppercase text-accent mb-3" data-aos="fade-up-sm">
              Gentle on Your Home
            </p>

            <!-- H1 -->
            <CustomHeading
              as="h1"
              text="Furniture You Can Feel **Good** About"
              svgColor="text-primary"
              class="text-4xl md:text-5xl lg:text-[3.75rem] font-bold text-dark mb-4 md:mb-6 leading-tight"
              dataAos="fade-up-sm"
              dataAosDelay="50"
            />

            <!-- H2 -->
            <h2 class="text-lg md:text-xl text-text/80 mb-6" data-aos="fade-up-sm" data-aos-delay="100">
              Clean Upholstery. Safe Ingredients. Peace of Mind.
            </h2>

            <!-- The Natural Logo -->
            <div class="flex items-center gap-4 mb-6" data-aos="fade-up-sm" data-aos-delay="150">
              <img
                src="/images/the-natural-bubbles.svg"
                alt="The Natural by Chem-Dry"
                class="h-16 w-auto"
                loading="lazy"
              />
              <div>
                <p class="text-base font-semibold text-dark">The Natural®</p>
                <p class="text-sm text-text/70">Our Cleaning Solution</p>
              </div>
            </div>

            <!-- Body Copy -->
            <div class="space-y-4 mb-8">
              <p class="text-base leading-relaxed text-text/80" data-aos="fade-up-sm" data-aos-delay="200">
                Your family spends hours every day on your furniture—relaxing, playing, and resting. That's why we use The Natural®, which uses carbonation and ingredients copied from Mother Nature. It contains no soaps, detergents, or fragrances.
              </p>

              <p class="text-base leading-relaxed text-text/80" data-aos="fade-up-sm" data-aos-delay="250">
                Unlike harsh detergents or chemical-laden cleaners, The Natural® uses millions of carbonating bubbles to gently lift dirt, body oils, and allergens to the surface—where they're whisked away with our powerful extraction system. No sticky residue. No harsh fumes. No worries.
              </p>

              <p class="text-base leading-relaxed text-text/80" data-aos="fade-up-sm" data-aos-delay="300">
                It's gentle on your upholstery, gentle on your kids and pets, and tough on dirt and allergens. This is the clean you can feel good about—because a truly clean home shouldn't come with a warning label.
              </p>
            </div>

            <!-- Trust Badges -->
            <div class="grid grid-cols-2 gap-4" data-aos="fade-up-sm" data-aos-delay="350">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-dark">EPA Certified</p>
                  <p class="text-xs text-text/70">Safer Choice approved</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-dark">No Harsh Chemicals</p>
                  <p class="text-xs text-text/70">No soaps or fragrances</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-dark">Healthier Air Quality</p>
                  <p class="text-xs text-text/70">Reduces allergens & dust mites</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-dark">No Harsh Chemicals</p>
                  <p class="text-xs text-text/70">Gentle on kids & pets</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Images -->
          <div class="order-1 lg:order-2 space-y-6">
            <!-- Family on Couch Image -->
            <div class="rounded-2xl overflow-hidden shadow-2xl" data-aos="fade-left-sm">
              <img
                src="/images/kids-game-carpet.webp"
                alt="Family relaxing safely on freshly cleaned upholstery"
                class="w-full h-auto"
                loading="lazy"
              />
            </div>

            <!-- EPA Safer Choice Badge -->
            <div class="bg-white p-6 rounded-xl shadow-lg flex items-center gap-4" data-aos="fade-left-sm" data-aos-delay="100">
              <img
                src="/images/epa-safer-choice.svg"
                alt="EPA Safer Choice Certified"
                class="h-20 w-auto flex-shrink-0"
                loading="lazy"
              />
              <div>
                <p class="text-sm font-semibold text-dark mb-1">EPA Safer Choice Certified</p>
                <p class="text-xs leading-relaxed text-text/70">
                  Meets the U.S. EPA's Safer Choice Standard for safety and performance.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- White Glove Service Details -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[65rem]">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wider uppercase text-primary mb-3" data-aos="fade-up-sm">
            What Makes Our Service "White Glove"?
          </p>
          <CustomHeading
            as="h2"
            text="The **Details** Matter"
            svgColor="text-primary"
            class="text-4xl md:text-5xl font-bold text-dark mb-4 md:mb-6"
            dataAos="fade-up-sm"
            dataAosDelay="50"
          />
        </div>

        <!-- Timeline -->
        <div class="space-y-8">
          <!-- Before -->
          <div class="flex gap-6" data-aos="fade-right-sm" data-aos-delay="100">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold">1</span>
              </div>
            </div>
            <div>
              <h4 class="text-xl font-semibold text-dark mb-3">Before We Arrive</h4>
              <ul class="space-y-2 text-base text-text/80">
                <li class="flex gap-2">
                  <span class="text-primary">•</span>
