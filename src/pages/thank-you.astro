---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Thank You | All Pro Chem-Dry"
  meta_title="Thank You | All Pro Chem-Dry"
  description="Thank you for requesting a quote. We'll contact you shortly."
>
  <main class="pt-32 pb-24">
    <div class="container max-w-2xl text-center">
      <div class="mb-8">
        <svg class="w-20 h-20 mx-auto text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold text-dark mb-6">
        Thank You!
      </h1>

      <p class="text-xl text-gray-600 mb-8">
        We've received your quote request and will contact you shortly.
      </p>

      <div class="bg-gray-50 rounded-lg p-6 mb-8">
        <p class="text-lg text-gray-700 mb-4">
          Need immediate assistance?
        </p>
        <a
          href="tel:3032520517"
          class="text-3xl font-bold text-primary hover:text-primary-dark transition-colors"
          data-track="phone-click"
          data-track-location="thank-you"
        >
          (303) 252-0517
        </a>
        <p class="text-sm text-gray-500 mt-2">
          Available Mon-Sat, 7am-6pm
        </p>
      </div>

      <a
        href="/"
        class="inline-block px-8 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors"
      >
        Return to Homepage
      </a>
    </div>
  </main>

  <script>
    // GTM conversion tracking (fires when ready)
    if (typeof window !== 'undefined') {
      const w = window as Window & { dataLayer?: Array<Record<string, string>> };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({
        event: 'form_submission_success',
        form_name: 'quote_request',
        conversion_type: 'lead'
      });
    }
  </script>
</Base>
